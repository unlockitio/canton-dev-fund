        <dc:Bounds x="196" y="320" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Start_Withdraw" bpmnElement="Start_Withdraw">
        <dc:Bounds x="100" y="330" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="91" y="366" width="55" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_ProposalSent" bpmnElement="End_ProposalSent">
        <dc:Bounds x="1076" y="110" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1060" y="72.5" width="67" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Deliver" bpmnElement="Task_Deliver">
        <dc:Bounds x="856" y="100" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Commit" bpmnElement="Task_Commit">
        <dc:Bounds x="636" y="100" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Define" bpmnElement="Task_Define">
        <dc:Bounds x="416" y="100" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_ValidateCapacity" bpmnElement="Task_ValidateCapacity">
        <dc:Bounds x="196" y="100" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Start_Action" bpmnElement="Start_Action">
        <dc:Bounds x="100" y="110" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="77" y="146" width="83" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_P12" bpmnElement="P12">
        <di:waypoint x="1016" y="488" />
        <di:waypoint x="1076" y="488" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_P11" bpmnElement="P11">
        <di:waypoint x="796" y="488" />
        <di:waypoint x="856" y="488" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_P10" bpmnElement="P10">
        <di:waypoint x="576" y="488" />
        <di:waypoint x="636" y="488" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_P9" bpmnElement="P9">
        <di:waypoint x="356" y="488" />
        <di:waypoint x="416" y="488" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_P8" bpmnElement="P8">
        <di:waypoint x="136" y="488" />
        <di:waypoint x="196" y="488" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_P7" bpmnElement="P7">
        <di:waypoint x="356" y="348" />
        <di:waypoint x="416" y="348" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_P6" bpmnElement="P6">
        <di:waypoint x="136" y="348" />
        <di:waypoint x="196" y="348" />
