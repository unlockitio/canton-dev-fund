<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_01B" targetNamespace="https://unlockit.io/veridica/bpmn">
  <bpmn:message id="Message_CommittedProposal" name="Committed Governance Proposal" />
  <bpmn:message id="Message_Withdrawal" name="Governance Proposal withdrawal" />
  <bpmn:message id="Message_RevisionRequest" name="Governance Proposal revision request" />
  <bpmn:message id="Message_BallotRequest" name="Governance Proposal + Ballot Request" />
  <bpmn:message id="Message_Ballot" name="Stakeholder ballot" />
  <bpmn:message id="Message_Outcome" name="Approved GovernanceOutcome" />
  <bpmn:signal id="Signal_ReviewCompleted" name="Review completed" />
  <bpmn:collaboration id="Collaboration_01B">
    <bpmn:participant id="Participant_Proposer" name="Proposer" processRef="Process_Proposer" />
    <bpmn:participant id="Participant_Governor" name="Governor" processRef="Process_Governor" />
    <bpmn:participant id="Participant_Resolver" name="Resolver" processRef="Process_Resolver" />
    <bpmn:participant id="Participant_Executor" name="Executor set" processRef="Process_Executor" />
    <bpmn:participant id="Participant_Stakeholder" name="Relevant Stakeholder (one per policy-defined stakeholder)" processRef="Process_Stakeholder">
      <bpmn:participantMultiplicity minimum="1" maximum="2147483647" />
    </bpmn:participant>
    <bpmn:messageFlow id="MF_Proposal" name="Committed Governance Proposal" sourceRef="End_ProposalSent" targetRef="Start_Proposal" />
    <bpmn:messageFlow id="MF_Withdrawal" name="Governance Proposal withdrawal" sourceRef="End_WithdrawalSent" targetRef="Catch_Withdrawal" />
    <bpmn:messageFlow id="MF_Revision" name="Governance Proposal revision request" sourceRef="End_RevisionRequestSent" targetRef="Start_Revision" />
    <bpmn:messageFlow id="MF_Outcome" name="Approved Governance Outcome" sourceRef="End_OutcomeSent" targetRef="Start_Outcome" />
    <bpmn:messageFlow id="MF_Ballot" name="Stakeholder ballot" sourceRef="End_BallotSent" targetRef="Start_Ballot" />
    <bpmn:messageFlow id="MF_BallotRequest" name="Governance Proposal + Ballot Request" sourceRef="End_BallotRequestSent" targetRef="Start_BallotRequest" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Proposer" isExecutable="false">
    <bpmn:laneSet id="Lanes_Proposer">
      <bpmn:lane id="Lane_Proposer" name="Proposer">
        <bpmn:flowNodeRef>Start_Action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateCapacity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Define</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ProposalSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_WithdrawalSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Revision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RevisionValidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RevisionDefine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RevisionCommit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RevisionDeliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RevisionDelivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="P12" sourceRef="Task_RevisionDeliver" targetRef="End_RevisionDelivered" />
    <bpmn:sequenceFlow id="P11" sourceRef="Task_RevisionCommit" targetRef="Task_RevisionDeliver" />
    <bpmn:sequenceFlow id="P10" sourceRef="Task_RevisionDefine" targetRef="Task_RevisionCommit" />
    <bpmn:sequenceFlow id="P9" sourceRef="Task_RevisionValidate" targetRef="Task_RevisionDefine" />
    <bpmn:sequenceFlow id="P8" sourceRef="Start_Revision" targetRef="Task_RevisionValidate" />
    <bpmn:sequenceFlow id="P7" sourceRef="Task_Withdraw" targetRef="End_WithdrawalSent" />
    <bpmn:sequenceFlow id="P6" sourceRef="Start_Withdraw" targetRef="Task_Withdraw" />
    <bpmn:sequenceFlow id="P5" sourceRef="Task_Deliver" targetRef="End_ProposalSent" />
    <bpmn:sequenceFlow id="P4" sourceRef="Task_Commit" targetRef="Task_Deliver" />
    <bpmn:sequenceFlow id="P3" sourceRef="Task_Define" targetRef="Task_Commit" />
    <bpmn:sequenceFlow id="P2" sourceRef="Task_ValidateCapacity" targetRef="Task_Define" />
    <bpmn:sequenceFlow id="P1" sourceRef="Start_Action" targetRef="Task_ValidateCapacity" />
    <bpmn:endEvent id="End_RevisionDelivered" name="New cycle delivered">
      <bpmn:incoming>P12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_RevisionDeliver" name="Deliver new committed proposal">
      <bpmn:incoming>P11</bpmn:incoming>
      <bpmn:outgoing>P12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RevisionCommit" name="Commit new Governance Proposal">
      <bpmn:incoming>P10</bpmn:incoming>
      <bpmn:outgoing>P11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RevisionDefine" name="Define new Governance Proposal">
      <bpmn:incoming>P9</bpmn:incoming>
      <bpmn:outgoing>P10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RevisionValidate" name="Validate capacity for new cycle">
      <bpmn:incoming>P8</bpmn:incoming>
      <bpmn:outgoing>P9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="Start_Revision" name="Revision request received">
      <bpmn:outgoing>P8</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_RevisionRequest" />
    </bpmn:startEvent>
    <bpmn:endEvent id="End_WithdrawalSent" name="Withdrawal sent">
      <bpmn:incoming>P7</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_Withdrawal" />
    </bpmn:endEvent>
    <bpmn:task id="Task_Withdraw" name="Withdraw proposal">
      <bpmn:incoming>P6</bpmn:incoming>
      <bpmn:outgoing>P7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="Start_Withdraw" name="Withdrawal requested">
      <bpmn:outgoing>P6</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="End_ProposalSent" name="Committed proposal sent">
      <bpmn:incoming>P5</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_CommittedProposal" />
    </bpmn:endEvent>
    <bpmn:task id="Task_Deliver" name="Deliver committed Governance Proposal">
      <bpmn:incoming>P4</bpmn:incoming>
      <bpmn:outgoing>P5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Commit" name="Commit Governance Proposal">
      <bpmn:incoming>P3</bpmn:incoming>
      <bpmn:outgoing>P4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Define" name="Define Governance Proposal">
      <bpmn:incoming>P2</bpmn:incoming>
      <bpmn:outgoing>P3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ValidateCapacity" name="Validate capacity">
      <bpmn:incoming>P1</bpmn:incoming>
      <bpmn:outgoing>P2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="Start_Action" name="Action requested">
      <bpmn:outgoing>P1</bpmn:outgoing>
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:process id="Process_Governor" isExecutable="false">
    <bpmn:laneSet id="Lanes_Governor">
      <bpmn:lane id="Lane_Governor" name="Governor" />
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="G1" sourceRef="Start_Proposal" targetRef="Gateway_ReviewOrWithdrawal" />
    <bpmn:sequenceFlow id="GW2" sourceRef="Gateway_ReviewOrWithdrawal" targetRef="Catch_Withdrawal" />
    <bpmn:sequenceFlow id="GW3" sourceRef="Catch_ReviewCompleted" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="GW4" sourceRef="Catch_Withdrawal" targetRef="End_Withdrawn" />
    <bpmn:sequenceFlow id="G2" sourceRef="Task_Review" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="G4" sourceRef="Gateway_Approved" targetRef="Task_Distribute" />
    <bpmn:sequenceFlow id="G5" sourceRef="Gateway_Approved" targetRef="Task_RequestRevision" />
    <bpmn:intermediateCatchEvent id="Catch_Withdrawal" name="Withdrawal received">
      <bpmn:incoming>GW2</bpmn:incoming>
      <bpmn:outgoing>GW4</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Withdrawal" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_BallotRequestSent" name="Ballot request sent">
      <bpmn:incoming>G6</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_BallotRequest" />
    </bpmn:endEvent>
    <bpmn:endEvent id="End_RevisionRequestSent" name="Revision request sent">
      <bpmn:incoming>G7</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_RevisionRequest" />
    </bpmn:endEvent>
    <bpmn:task id="Task_RequestRevision" name="Request revision">
      <bpmn:incoming>G5</bpmn:incoming>
      <bpmn:outgoing>G7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Distribute" name="Distribute proposal + Ballot Request">
      <bpmn:incoming>G4</bpmn:incoming>
      <bpmn:outgoing>G6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="G6" sourceRef="Task_Distribute" targetRef="End_BallotRequestSent" />
    <bpmn:sequenceFlow id="G7" sourceRef="Task_RequestRevision" targetRef="End_RevisionRequestSent" />
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?" default="G5">
      <bpmn:incoming>G2</bpmn:incoming>
      <bpmn:outgoing>G4</bpmn:outgoing>
      <bpmn:outgoing>G5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Review" name="Review committed proposal">
      <bpmn:incoming>GW3</bpmn:incoming>
      <bpmn:outgoing>G2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="Gateway_ReviewOrWithdrawal" name="Review completed or withdrawal?">
      <bpmn:incoming>G1</bpmn:incoming>
      <bpmn:outgoing>GW2</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:startEvent id="Start_Proposal" name="Committed proposal received">
      <bpmn:outgoing>G1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CommittedProposal" />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="Catch_ReviewCompleted" name="Review completed">
      <bpmn:outgoing>GW3</bpmn:outgoing>
      <bpmn:signalEventDefinition signalRef="Signal_ReviewCompleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Withdrawn" name="Proposal withdrawn">
      <bpmn:incoming>GW4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_Resolver" isExecutable="false">
    <bpmn:laneSet id="Lanes_Resolver">
      <bpmn:lane id="Lane_Resolver" name="Resolver">
        <bpmn:flowNodeRef>Start_Ballot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Verdict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OutcomeSent</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Ballot" name="Ballot received">
      <bpmn:outgoing>R1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Ballot" />
    </bpmn:startEvent>
    <bpmn:task id="Task_Resolve" name="Evaluate and resolve Governance Proposal">
      <bpmn:incoming>R1</bpmn:incoming>
      <bpmn:outgoing>R2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Verdict" name="Verdict?">
      <bpmn:incoming>R2</bpmn:incoming>
      <bpmn:outgoing>R3</bpmn:outgoing>
      <bpmn:outgoing>R4</bpmn:outgoing>
      <bpmn:outgoing>R5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CreateOutcome" name="Create GovernanceOutcome">
      <bpmn:incoming>R3</bpmn:incoming>
      <bpmn:outgoing>R6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_OutcomeSent" name="Approved outcome sent">
      <bpmn:incoming>R6</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_Outcome" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="R1" sourceRef="Start_Ballot" targetRef="Task_Resolve" />
    <bpmn:sequenceFlow id="R2" sourceRef="Task_Resolve" targetRef="Gateway_Verdict" />
    <bpmn:sequenceFlow id="R3" sourceRef="Gateway_Verdict" targetRef="Task_CreateOutcome" />
    <bpmn:sequenceFlow id="R4" sourceRef="Gateway_Verdict" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="R5" sourceRef="Gateway_Verdict" targetRef="End_Lapsed" />
    <bpmn:sequenceFlow id="R6" sourceRef="Task_CreateOutcome" targetRef="End_OutcomeSent" />
    <bpmn:endEvent id="End_Rejected" name="VRejected">
      <bpmn:incoming>R4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Lapsed" name="VLapsed">
      <bpmn:incoming>R5</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_Executor" isExecutable="false">
    <bpmn:laneSet id="Lanes_Executor">
      <bpmn:lane id="Lane_Executor" name="Executor set" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Outcome" name="Approved outcome received">
      <bpmn:outgoing>E1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Outcome" />
    </bpmn:startEvent>
    <bpmn:task id="Task_ValidateExecution" name="Validate executable outcome">
      <bpmn:incoming>E1</bpmn:incoming>
      <bpmn:outgoing>E2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Execute" name="Execution permitted?">
      <bpmn:incoming>E2</bpmn:incoming>
      <bpmn:outgoing>E3</bpmn:outgoing>
      <bpmn:outgoing>E4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Execute" name="Execute GovernanceOutcome">
      <bpmn:incoming>E3</bpmn:incoming>
      <bpmn:outgoing>E5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Executed" name="Outcome executed">
      <bpmn:incoming>E5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Expired" name="Outcome expired">
      <bpmn:incoming>E4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="E1" sourceRef="Start_Outcome" targetRef="Task_ValidateExecution" />
    <bpmn:sequenceFlow id="E2" sourceRef="Task_ValidateExecution" targetRef="Gateway_Execute" />
    <bpmn:sequenceFlow id="E3" sourceRef="Gateway_Execute" targetRef="Task_Execute" />
    <bpmn:sequenceFlow id="E4" sourceRef="Gateway_Execute" targetRef="End_Expired" />
    <bpmn:sequenceFlow id="E5" sourceRef="Task_Execute" targetRef="End_Executed" />
  </bpmn:process>
  <bpmn:process id="Process_Stakeholder" isExecutable="false">
    <bpmn:laneSet id="Lanes_Stakeholder">
      <bpmn:lane id="Lane_Stakeholder" name="Relevant Stakeholder">
        <bpmn:flowNodeRef>Start_BallotRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitBallot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BallotSent</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:endEvent id="End_BallotSent" name="Ballot sent">
      <bpmn:incoming>S2</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_Ballot" />
    </bpmn:endEvent>
    <bpmn:task id="Task_SubmitBallot" name="Submit ballot">
      <bpmn:incoming>S1</bpmn:incoming>
      <bpmn:outgoing>S2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="S2" sourceRef="Task_SubmitBallot" targetRef="End_BallotSent" />
    <bpmn:startEvent id="Start_BallotRequest" name="Ballot request received">
      <bpmn:outgoing>S1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_BallotRequest" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="S1" sourceRef="Start_BallotRequest" targetRef="Task_SubmitBallot" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_01B">
    <bpmndi:BPMNPlane id="Plane_01B" bpmnElement="Collaboration_01B">
      <bpmndi:BPMNShape id="DI_Proposer" bpmnElement="Participant_Proposer" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="2460" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_RevisionDelivered" bpmnElement="End_RevisionDelivered">
