        <dc:Bounds x="856" y="460" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_RevisionCommit" bpmnElement="Task_RevisionCommit">
        <dc:Bounds x="636" y="460" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_RevisionDefine" bpmnElement="Task_RevisionDefine">
        <dc:Bounds x="416" y="460" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_RevisionValidate" bpmnElement="Task_RevisionValidate">
        <dc:Bounds x="196" y="460" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Start_Revision" bpmnElement="Start_Revision">
        <dc:Bounds x="100" y="470" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="77" y="506" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_WithdrawalSent" bpmnElement="End_WithdrawalSent">
        <dc:Bounds x="416" y="330" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="394" y="306" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
