    <bpmn:task id="Task_Execute" name="Execute Governance Outcome">
      <bpmn:incoming>E3</bpmn:incoming>
      <bpmn:outgoing>E5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Executed" name="Outcome executed">
      <bpmn:incoming>E5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Expired" name="Outcome expired">
      <bpmn:incoming>E4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="E1" sourceRef="Start_Outcome" targetRef="Task_ValidateExecution" />
    <bpmn:sequenceFlow id="E2" sourceRef="Task_ValidateExecution" targetRef="Gateway_Execute" />
    <bpmn:sequenceFlow id="E3" sourceRef="Gateway_Execute" targetRef="Task_Execute" />
    <bpmn:sequenceFlow id="E4" sourceRef="Gateway_Execute" targetRef="End_Expired" />
    <bpmn:sequenceFlow id="E5" sourceRef="Task_Execute" targetRef="End_Executed" />
  </bpmn:process>
  <bpmn:process id="Process_Stakeholder" isExecutable="false">
