    <bpmn:sequenceFlow id="R4" sourceRef="Gateway_Verdict" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="R5" sourceRef="Gateway_Verdict" targetRef="End_Lapsed" />
    <bpmn:sequenceFlow id="R6" sourceRef="Task_CreateOutcome" targetRef="End_OutcomeSent" />
  </bpmn:process>
  <bpmn:process id="Process_Executor" isExecutable="false">
