<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_01B" targetNamespace="https://unlockit.io/veridica/bpmn">
  <bpmn:message id="Message_CommittedProposal" name="Committed Governance Proposal" />
  <bpmn:message id="Message_Withdrawal" name="Governance Proposal withdrawal" />
  <bpmn:message id="Message_RevisionRequest" name="Governance Proposal revision request" />
  <bpmn:message id="Message_BallotRequest" name="Governance Proposal + Ballot Request" />
  <bpmn:message id="Message_Ballot" name="Stakeholder ballot" />
  <bpmn:message id="Message_Outcome" name="Approved GovernanceOutcome" />
  <bpmn:signal id="Signal_ReviewCompleted" name="Review completed" />
  <bpmn:collaboration id="Collaboration_01B">
    <bpmn:participant id="Participant_Proposer" name="Proposer" processRef="Process_Proposer" />
    <bpmn:participant id="Participant_Governor" name="Governor" processRef="Process_Governor" />
    <bpmn:participant id="Participant_Resolver" name="Resolver" processRef="Process_Resolver" />
    <bpmn:participant id="Participant_Executor" name="Executor set" processRef="Process_Executor" />
    <bpmn:participant id="Participant_Stakeholder" name="Relevant Stakeholder (one per policy-defined stakeholder)" processRef="Process_Stakeholder">
      <bpmn:participantMultiplicity minimum="1" maximum="2147483647" />
    </bpmn:participant>
    <bpmn:messageFlow id="MF_Proposal" name="Committed Governance Proposal" sourceRef="End_ProposalSent" targetRef="Start_Proposal" />
    <bpmn:messageFlow id="MF_Revision" name="Governance Proposal revision request" sourceRef="End_RevisionRequestSent" targetRef="Start_Revision" />
    <bpmn:messageFlow id="MF_Outcome" name="Approved Governance Outcome" sourceRef="End_OutcomeSent" targetRef="Start_Outcome" />
    <bpmn:messageFlow id="MF_BallotRequest" name="Governance Proposal + Ballot Request" sourceRef="End_BallotRequestSent" targetRef="Start_BallotRequest" />
    <bpmn:messageFlow id="Flow_058en4z" name="Committed Governance Proposal" sourceRef="Event_0qapmgd" targetRef="Start_Proposal" />
    <bpmn:textAnnotation id="Annotation_ApplicableGovernanceRule">
      <bpmn:text>The applicable governance rule may vary by case, including quorum, voting weight, timeout, delegation, or abstention handling. These variations are intentionally not defined here.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ApplicableGovernanceRule" sourceRef="Start_Ballot" targetRef="Annotation_ApplicableGovernanceRule" />
    <bpmn:textAnnotation id="Annotation_ProposalPreparation">
      <bpmn:text>Proposer validates capacity, defines and commits the Governance Proposal, then delivers it for Governor review.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ProposalPreparation" sourceRef="Task_ValidateCapacity" targetRef="Annotation_ProposalPreparation" />
    <bpmn:textAnnotation id="Annotation_RevisionPreparation">
      <bpmn:text>Proposer validates capacity for the new cycle, defines and commits the revised Governance Proposal, then delivers it.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_RevisionPreparation" sourceRef="Task_RevisionValidate" targetRef="Annotation_RevisionPreparation" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Proposer" isExecutable="false">
    <bpmn:laneSet id="Lanes_Proposer">
      <bpmn:lane id="Lane_Proposer" name="Proposer">
        <bpmn:flowNodeRef>Start_Action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateCapacity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_WithdrawalSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Revision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RevisionValidate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="P8" sourceRef="Start_Revision" targetRef="Task_RevisionValidate" />
    <bpmn:sequenceFlow id="P7" sourceRef="Task_Withdraw" targetRef="End_WithdrawalSent" />
    <bpmn:sequenceFlow id="P6" sourceRef="Start_Withdraw" targetRef="Task_Withdraw" />
    <bpmn:sequenceFlow id="P5" sourceRef="Task_ValidateCapacity" targetRef="End_ProposalSent" />
    <bpmn:sequenceFlow id="P1" sourceRef="Start_Action" targetRef="Task_ValidateCapacity" />
    <bpmn:task id="Task_RevisionValidate" name="Prepare and deliver revised Governance Proposal">
      <bpmn:incoming>P8</bpmn:incoming>
      <bpmn:outgoing>Flow_0smsrdv</bpmn:outgoing>
