        <di:waypoint x="856" y="278" />
        <di:waypoint x="920" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_VP_R2" bpmnElement="VP_R2">
        <di:waypoint x="856" y="358" />
        <di:waypoint x="920" y="358" />
        <di:waypoint x="920" y="296" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="DI_Participant_Process_ContributorParty_02a" bpmnElement="Participant_Process_ContributorParty_02a" isHorizontal="true">
        <dc:Bounds x="20" y="580" width="1540" height="420" />
