        <dc:Bounds x="220" y="250" width="180" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VP_ResponseDecision" bpmnElement="VP_ResponseDecision" isMarkerVisible="true">
        <dc:Bounds x="460" y="250" width="56" height="56" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="440" y="216" width="96" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VP_RequestEvidence" bpmnElement="VP_RequestEvidence">
