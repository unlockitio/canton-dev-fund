<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_veridica_contributor_actions" targetNamespace="https://unlockit.io/veridica/bpmn" exporter="Veridica deterministic renderer" exporterVersion="4.0">
  <bpmn:message id="Message_ContributorAuthorized" name="Contributor_Authorized" />
  <bpmn:message id="Message_ContributionSubmit" name="Contribution_Submit" />
  <bpmn:message id="Message_ContributionRespond" name="Contribution_Respond" />
  <bpmn:message id="Message_EvidenceRequest" name="Evidence_Request" />
  <bpmn:message id="Message_Challenge" name="Challenge" />
  <bpmn:message id="Message_Correction" name="Correction" />
  <bpmn:message id="Message_EvidenceResubmitted" name="Evidence_Resubmitted" />
  <bpmn:message id="Message_GovernanceInterruption" name="Governance suspension or rotation" />
  <bpmn:collaboration id="Collaboration_02a">
    <bpmn:participant id="Participant_VeridicaPlatform_02a" name="Veridica Platform" processRef="Process_VeridicaPlatform_02a" />
    <bpmn:participant id="Participant_Verifier_External_02a" name="Verifier Party (03b, external owner of contribution validation)">
      <bpmn:participantMultiplicity minimum="1" maximum="999" />
    </bpmn:participant>
    <bpmn:participant id="Participant_Process_ContributorParty_02a" name="Contributor Party (multiplicity 1..999)" processRef="Process_ContributorParty_02a">
      <bpmn:participantMultiplicity minimum="1" maximum="999" />
    </bpmn:participant>
    <bpmn:participant id="Participant_Chassis_External" name="Participant lifecycle chassis (02, external source of Contributor_Authorized)">
      <bpmn:participantMultiplicity minimum="1" maximum="999" />
    </bpmn:participant>
    <bpmn:messageFlow id="MF_ContributorAuthorized" name="Contributor_Authorized" sourceRef="Participant_Chassis_External" targetRef="CT_Authorized" />
    <bpmn:messageFlow id="MF_ContributionSubmit" name="Contribution_Submit" sourceRef="CT_ContributionSubmitSent" targetRef="VP_SubmissionReceived" />
    <bpmn:messageFlow id="MF_ContributionRespond" name="Contribution_Respond" sourceRef="CT_ContributionRespondSent" targetRef="VP_ResponseReceived" />
    <bpmn:messageFlow id="MF_InitialContribution" name="Contribution_Submit" sourceRef="VP_ProcessSubmission" targetRef="Participant_Verifier_External_02a" />
    <bpmn:messageFlow id="MF_EvidenceResubmitted" name="Evidence_Resubmitted" sourceRef="VP_ProcessResponse" targetRef="Participant_Verifier_External_02a" />
    <bpmn:messageFlow id="MF_EvidenceRequest" name="Evidence_Request" sourceRef="Participant_Verifier_External_02a" targetRef="VP_RequestEvidence" />
    <bpmn:messageFlow id="MF_Challenge" name="Challenge" sourceRef="Participant_Verifier_External_02a" targetRef="VP_Challenge" />
    <bpmn:messageFlow id="MF_Correction" name="Correction" sourceRef="Participant_Verifier_External_02a" targetRef="VP_RequestCorrection" />
    <bpmn:messageFlow id="MF_ForwardEvidenceRequest" name="Evidence_Request" sourceRef="VP_EvidenceRequestSent" targetRef="CT_EvidenceRequestReceived" />
    <bpmn:messageFlow id="MF_ForwardChallenge" name="Challenge" sourceRef="VP_ChallengeSent" targetRef="CT_ChallengeReceived" />
    <bpmn:messageFlow id="MF_ForwardCorrection" name="Correction" sourceRef="VP_CorrectionSent" targetRef="CT_CorrectionReceived" />
    <bpmn:messageFlow id="MF_GovernanceInterruption" name="Governance suspension or rotation" sourceRef="Participant_Chassis_External" targetRef="CT_GovernanceInterruption" />
  </bpmn:collaboration>
  <bpmn:process id="Process_VeridicaPlatform_02a" isExecutable="false">
    <bpmn:laneSet id="Lanes_VeridicaPlatform_02a">
      <bpmn:lane id="Lane_VeridicaPlatform_02a" name="Veridica Platform">
        <bpmn:flowNodeRef>VP_SubmissionReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_ProcessSubmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_ResponseDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_RequestEvidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_EvidenceRequestSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Challenge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_ChallengeSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_RequestCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_CorrectionSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_ResponseReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_ProcessResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="VP_SubmissionReceived" name="Submission received">
      <bpmn:outgoing>VP1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ContributionSubmit" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="VP_ProcessSubmission" name="Check contribution envelope, record submission, and route deterministically to assigned Verifier">
      <bpmn:incoming>VP1</bpmn:incoming>
      <bpmn:outgoing>VP2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="VP_ResponseDecision" name="Wait for Verifier-issued message">
      <bpmn:incoming>VP2</bpmn:incoming>
      <bpmn:outgoing>VP3</bpmn:outgoing>
      <bpmn:outgoing>VP4</bpmn:outgoing>
      <bpmn:outgoing>VP5</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="VP_RequestEvidence" name="Receive, record, and forward Verifier Evidence_Request" messageRef="Message_EvidenceRequest">
      <bpmn:incoming>VP3</bpmn:incoming>
      <bpmn:outgoing>VP3a</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:intermediateThrowEvent id="VP_EvidenceRequestSent" name="Evidence request forwarded">
      <bpmn:incoming>VP3a</bpmn:incoming>
      <bpmn:outgoing>VP6</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_EvidenceRequest" />
    </bpmn:intermediateThrowEvent>
    <bpmn:receiveTask id="VP_Challenge" name="Receive, record, and forward Verifier Challenge" messageRef="Message_Challenge">
      <bpmn:incoming>VP4</bpmn:incoming>
      <bpmn:outgoing>VP4a</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:intermediateThrowEvent id="VP_ChallengeSent" name="Challenge forwarded">
      <bpmn:incoming>VP4a</bpmn:incoming>
      <bpmn:outgoing>VP_R1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Challenge" />
    </bpmn:intermediateThrowEvent>
    <bpmn:receiveTask id="VP_RequestCorrection" name="Receive, record, and forward Verifier Correction" messageRef="Message_Correction">
      <bpmn:incoming>VP5</bpmn:incoming>
      <bpmn:outgoing>VP5a</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:intermediateThrowEvent id="VP_CorrectionSent" name="Correction forwarded">
      <bpmn:incoming>VP5a</bpmn:incoming>
      <bpmn:outgoing>VP_R2</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Correction" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="VP_ResponseReceived" name="Contributor response received">
      <bpmn:incoming>VP6</bpmn:incoming>
      <bpmn:incoming>VP_R1</bpmn:incoming>
      <bpmn:incoming>VP_R2</bpmn:incoming>
      <bpmn:outgoing>VP7</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ContributionRespond" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="VP_ProcessResponse" name="Record Contributor response and route deterministically to assigned Verifier">
      <bpmn:incoming>VP7</bpmn:incoming>
      <bpmn:outgoing>VP8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="VP_End" name="Contributor response routed to Verifier">
      <bpmn:incoming>VP8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="VP1" sourceRef="VP_SubmissionReceived" targetRef="VP_ProcessSubmission" />
    <bpmn:sequenceFlow id="VP2" sourceRef="VP_ProcessSubmission" targetRef="VP_ResponseDecision" />
    <bpmn:sequenceFlow id="VP3" name="Verifier issued Evidence_Request" sourceRef="VP_ResponseDecision" targetRef="VP_RequestEvidence" />
    <bpmn:sequenceFlow id="VP3a" sourceRef="VP_RequestEvidence" targetRef="VP_EvidenceRequestSent" />
    <bpmn:sequenceFlow id="VP4" name="Verifier issued Challenge" sourceRef="VP_ResponseDecision" targetRef="VP_Challenge" />
    <bpmn:sequenceFlow id="VP4a" sourceRef="VP_Challenge" targetRef="VP_ChallengeSent" />
    <bpmn:sequenceFlow id="VP5" name="Verifier issued Correction" sourceRef="VP_ResponseDecision" targetRef="VP_RequestCorrection" />
    <bpmn:sequenceFlow id="VP5a" sourceRef="VP_RequestCorrection" targetRef="VP_CorrectionSent" />
    <bpmn:sequenceFlow id="VP6" sourceRef="VP_EvidenceRequestSent" targetRef="VP_ResponseReceived" />
    <bpmn:sequenceFlow id="VP7" sourceRef="VP_ResponseReceived" targetRef="VP_ProcessResponse" />
    <bpmn:sequenceFlow id="VP8" sourceRef="VP_ProcessResponse" targetRef="VP_End" />
    <bpmn:sequenceFlow id="VP_R1" sourceRef="VP_ChallengeSent" targetRef="VP_ResponseReceived" />
    <bpmn:sequenceFlow id="VP_R2" sourceRef="VP_CorrectionSent" targetRef="VP_ResponseReceived" />
  </bpmn:process>
  <bpmn:process id="Process_ContributorParty_02a" isExecutable="false">
    <bpmn:laneSet id="Lanes_ContributorParty_02a">
      <bpmn:lane id="Lane_ContributorParty_02a" name="Contributor Party">
        <bpmn:flowNodeRef>CT_Authorized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_SelectPolicy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_ContributionSubmitSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_WaitForResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_EvidenceRequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_ChallengeReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_CorrectionReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_Respond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_ContributionRespondSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_GovernanceInterruption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_Interrupted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CT_Authorized" name="Contributor_Authorized received">
      <bpmn:outgoing>CT1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ContributorAuthorized" />
    </bpmn:startEvent>
    <bpmn:task id="CT_SelectPolicy" name="Select standard version and Observation Key policy">
      <bpmn:incoming>CT1</bpmn:incoming>
      <bpmn:outgoing>CT2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="CT_Submit" name="Submit Contribution ID, information or reference, and evidence">
      <bpmn:incoming>CT2</bpmn:incoming>
      <bpmn:outgoing>CT3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="CT_ContributionSubmitSent" name="Contribution_Submit sent">
      <bpmn:incoming>CT3</bpmn:incoming>
      <bpmn:outgoing>CT4</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ContributionSubmit" />
    </bpmn:intermediateThrowEvent>
    <bpmn:eventBasedGateway id="CT_WaitForResponse" name="Wait for Evidence_Request, Challenge, or Correction">
      <bpmn:incoming>CT4</bpmn:incoming>
      <bpmn:outgoing>CT5</bpmn:outgoing>
      <bpmn:outgoing>CT6</bpmn:outgoing>
      <bpmn:outgoing>CT7</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="CT_EvidenceRequestReceived" name="Evidence_Request received">
      <bpmn:incoming>CT5</bpmn:incoming>
      <bpmn:outgoing>CT8</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_EvidenceRequest" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="CT_ChallengeReceived" name="Challenge received">
      <bpmn:incoming>CT6</bpmn:incoming>
      <bpmn:outgoing>CT8b</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Challenge" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="CT_CorrectionReceived" name="Correction received">
      <bpmn:incoming>CT7</bpmn:incoming>
      <bpmn:outgoing>CT8c</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Correction" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="CT_Respond" name="Respond to Verifier evidence request, challenge, or correction (handles both initial and correction responses via contract version)">
      <bpmn:incoming>CT8</bpmn:incoming>
      <bpmn:incoming>CT8b</bpmn:incoming>
      <bpmn:incoming>CT8c</bpmn:incoming>
      <bpmn:outgoing>CT9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="CT_ContributionRespondSent" name="Contribution_Respond sent">
      <bpmn:incoming>CT9</bpmn:incoming>
      <bpmn:outgoing>CT10</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ContributionRespond" />
    </bpmn:intermediateThrowEvent>
    <bpmn:boundaryEvent id="CT_GovernanceInterruption" name="Governance suspension or rotation arriving mid-submission" attachedToRef="CT_Submit">
      <bpmn:outgoing>CT_BI1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_GovernanceInterruption" />
    </bpmn:boundaryEvent>
    <bpmn:task id="CT_ApplyInterruption" name="Apply governance suspension or rotation">
      <bpmn:incoming>CT_BI1</bpmn:incoming>
      <bpmn:outgoing>CT_BI2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="CT_Interrupted" name="Contributor suspended or rotated by governance">
      <bpmn:incoming>CT_BI2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="CT_End" name="Contribution submission complete">
      <bpmn:incoming>CT10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CT1" sourceRef="CT_Authorized" targetRef="CT_SelectPolicy" />
    <bpmn:sequenceFlow id="CT2" sourceRef="CT_SelectPolicy" targetRef="CT_Submit" />
    <bpmn:sequenceFlow id="CT3" sourceRef="CT_Submit" targetRef="CT_ContributionSubmitSent" />
    <bpmn:sequenceFlow id="CT4" sourceRef="CT_ContributionSubmitSent" targetRef="CT_WaitForResponse" />
    <bpmn:sequenceFlow id="CT5" sourceRef="CT_WaitForResponse" targetRef="CT_EvidenceRequestReceived" />
    <bpmn:sequenceFlow id="CT6" sourceRef="CT_WaitForResponse" targetRef="CT_ChallengeReceived" />
    <bpmn:sequenceFlow id="CT7" sourceRef="CT_WaitForResponse" targetRef="CT_CorrectionReceived" />
    <bpmn:sequenceFlow id="CT8" sourceRef="CT_EvidenceRequestReceived" targetRef="CT_Respond" />
    <bpmn:sequenceFlow id="CT8b" sourceRef="CT_ChallengeReceived" targetRef="CT_Respond" />
    <bpmn:sequenceFlow id="CT8c" sourceRef="CT_CorrectionReceived" targetRef="CT_Respond" />
    <bpmn:sequenceFlow id="CT9" sourceRef="CT_Respond" targetRef="CT_ContributionRespondSent" />
    <bpmn:sequenceFlow id="CT10" sourceRef="CT_ContributionRespondSent" targetRef="CT_End" />
    <bpmn:sequenceFlow id="CT_BI1" sourceRef="CT_GovernanceInterruption" targetRef="CT_ApplyInterruption" />
    <bpmn:sequenceFlow id="CT_BI2" sourceRef="CT_ApplyInterruption" targetRef="CT_Interrupted" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_02a">
    <bpmndi:BPMNPlane id="Plane_02a" bpmnElement="Collaboration_02a">
      <bpmndi:BPMNShape id="DI_Chassis_External" bpmnElement="Participant_Chassis_External" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1540" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Verifier_External_02a" bpmnElement="Participant_Verifier_External_02a" isHorizontal="true">
        <dc:Bounds x="20" y="1020" width="1540" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VeridicaPlatform_02a" bpmnElement="Participant_VeridicaPlatform_02a" isHorizontal="true">
        <dc:Bounds x="20" y="120" width="1540" height="440" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VP_SubmissionReceived" bpmnElement="VP_SubmissionReceived">
