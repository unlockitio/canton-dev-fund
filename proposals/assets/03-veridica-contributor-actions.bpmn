      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VP_Challenge" bpmnElement="VP_Challenge">
        <dc:Bounds x="580" y="250" width="180" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VP_ChallengeSent" bpmnElement="VP_ChallengeSent">
        <dc:Bounds x="820" y="260" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="780" y="296" width="116" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VP_RequestCorrection" bpmnElement="VP_RequestCorrection">
        <dc:Bounds x="580" y="330" width="180" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VP_CorrectionSent" bpmnElement="VP_CorrectionSent">
        <dc:Bounds x="820" y="340" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="780" y="376" width="116" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VP_ResponseReceived" bpmnElement="VP_ResponseReceived">
        <dc:Bounds x="920" y="260" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="880" y="296" width="116" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VP_ProcessResponse" bpmnElement="VP_ProcessResponse">
        <dc:Bounds x="1000" y="250" width="200" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VP_End" bpmnElement="VP_End">
        <dc:Bounds x="1240" y="260" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1200" y="296" width="116" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_VP1" bpmnElement="VP1">
        <di:waypoint x="156" y="278" />
