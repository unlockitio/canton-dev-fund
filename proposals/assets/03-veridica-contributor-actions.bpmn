<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_veridica_contributor_actions" targetNamespace="https://unlockit.io/veridica/bpmn" exporter="Veridica deterministic renderer" exporterVersion="4.0">
  <bpmn:message id="Message_ContributorAuthorized" name="Contributor_Authorized" />
  <bpmn:message id="Message_ContributionSubmit" name="Contribution_Submit" />
  <bpmn:message id="Message_EvidenceRequest" name="Evidence_Request" />
  <bpmn:message id="Message_Challenge" name="Challenge" />
  <bpmn:message id="Message_Correction" name="Correction" />
  <bpmn:message id="Message_EvidenceResubmitted" name="Evidence_Resubmitted" />
  <bpmn:message id="Message_VerifierAttestation" name="Verifier_Attestation" />
  <bpmn:message id="Message_GovernanceInterruption" name="Governance suspension or rotation" />
  <bpmn:collaboration id="Collaboration_03">
    <bpmn:participant id="Participant_Verifier_03" name="Verifier Party (multiplicity 1..999)" processRef="Process_Verifier_03">
      <bpmn:participantMultiplicity minimum="1" maximum="999" />
    </bpmn:participant>
    <bpmn:participant id="Participant_Contributor_03" name="Contributor Party (multiplicity 1..999)" processRef="Process_Contributor_03">
      <bpmn:participantMultiplicity minimum="1" maximum="999" />
    </bpmn:participant>
    <bpmn:participant id="Participant_Chassis_External" name="Participant lifecycle chassis (02, external source of Contributor_Authorized)">
      <bpmn:participantMultiplicity minimum="1" maximum="999" />
    </bpmn:participant>
    <bpmn:messageFlow id="MF_ContributorAuthorized" name="Contributor_Authorized" sourceRef="Participant_Chassis_External" targetRef="CT_Authorized" />
    <bpmn:messageFlow id="MF_ContributionSubmit" name="Contribution_Submit" sourceRef="CT_ContributionSubmitSent" targetRef="VR_SubmissionReceived" />
    <bpmn:messageFlow id="MF_EvidenceResubmitted" name="Evidence_Resubmitted" sourceRef="CT_EvidenceResubmittedSent" targetRef="VR_ResponseReceived" />
    <bpmn:messageFlow id="MF_EvidenceRequest" name="Evidence_Request" sourceRef="VR_EvidenceRequestSent" targetRef="CT_EvidenceRequestReceived" />
    <bpmn:messageFlow id="MF_Challenge" name="Challenge" sourceRef="VR_ChallengeSent" targetRef="CT_ChallengeReceived" />
    <bpmn:messageFlow id="MF_Correction" name="Correction" sourceRef="VR_CorrectionSent" targetRef="CT_CorrectionReceived" />
    <bpmn:messageFlow id="MF_VerifierAttestation" name="Verifier_Attestation" sourceRef="VR_AttestationSent" targetRef="CT_AttestationReceived" />
    <bpmn:messageFlow id="MF_GovernanceInterruption" name="Governance suspension or rotation" sourceRef="Participant_Chassis_External" targetRef="CT_GovernanceInterruption" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Verifier_03" isExecutable="false">
    <bpmn:laneSet id="Lanes_Verifier_03">
      <bpmn:lane id="Lane_Verifier_03" name="Verifier Party">
        <bpmn:flowNodeRef>VR_SubmissionReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_EvaluateEvidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_DetermineOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_RequestEvidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_EvidenceRequestSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_IssueChallenge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_ChallengeSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_IssueCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_CorrectionSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_CompleteAttestation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_AttestationSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_ResponseReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="VR_SubmissionReceived" name="Contribution_Submit received">
      <bpmn:outgoing>VR1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ContributionSubmit" />
    </bpmn:startEvent>
    <bpmn:task id="VR_EvaluateEvidence" name="Evaluate contribution evidence against validation, independence, and conflict rules">
      <bpmn:incoming>VR1</bpmn:incoming>
      <bpmn:incoming>VR12</bpmn:incoming>
      <bpmn:outgoing>VR2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="VR_DetermineOutcome" name="Determine supported Verifier action" default="VR6">
      <bpmn:incoming>VR2</bpmn:incoming>
      <bpmn:outgoing>VR3</bpmn:outgoing>
      <bpmn:outgoing>VR4</bpmn:outgoing>
      <bpmn:outgoing>VR5</bpmn:outgoing>
      <bpmn:outgoing>VR6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="VR_RequestEvidence" name="Request additional evidence">
      <bpmn:incoming>VR3</bpmn:incoming>
      <bpmn:outgoing>VR7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="VR_EvidenceRequestSent" name="Evidence_Request issued">
      <bpmn:incoming>VR7</bpmn:incoming>
      <bpmn:outgoing>VR10a</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_EvidenceRequest" />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="VR_IssueChallenge" name="Issue challenge with reasons">
      <bpmn:incoming>VR4</bpmn:incoming>
      <bpmn:outgoing>VR8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="VR_ChallengeSent" name="Challenge issued">
      <bpmn:incoming>VR8</bpmn:incoming>
      <bpmn:outgoing>VR10b</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Challenge" />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="VR_IssueCorrection" name="Issue correction preserving prior version and reasons">
      <bpmn:incoming>VR5</bpmn:incoming>
      <bpmn:outgoing>VR9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="VR_CorrectionSent" name="Correction issued">
      <bpmn:incoming>VR9</bpmn:incoming>
      <bpmn:outgoing>VR10c</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Correction" />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="VR_CompleteAttestation" name="Complete validation and record accountable attestation">
      <bpmn:incoming>VR6</bpmn:incoming>
      <bpmn:outgoing>VR13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="VR_AttestationSent" name="Verifier_Attestation issued">
      <bpmn:incoming>VR13</bpmn:incoming>
      <bpmn:outgoing>VR14</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_VerifierAttestation" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="VR_ResponseReceived" name="Evidence_Resubmitted received">
      <bpmn:incoming>VR10a</bpmn:incoming>
      <bpmn:incoming>VR10b</bpmn:incoming>
      <bpmn:incoming>VR10c</bpmn:incoming>
      <bpmn:outgoing>VR12</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_EvidenceResubmitted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="VR_End" name="Contribution validation attested">
      <bpmn:incoming>VR14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="VR1" sourceRef="VR_SubmissionReceived" targetRef="VR_EvaluateEvidence" />
    <bpmn:sequenceFlow id="VR2" sourceRef="VR_EvaluateEvidence" targetRef="VR_DetermineOutcome" />
    <bpmn:sequenceFlow id="VR3" name="Additional evidence required" sourceRef="VR_DetermineOutcome" targetRef="VR_RequestEvidence">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">additional evidence required</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="VR4" name="Challenge required" sourceRef="VR_DetermineOutcome" targetRef="VR_IssueChallenge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">challenge required</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="VR5" name="Correction required" sourceRef="VR_DetermineOutcome" targetRef="VR_IssueCorrection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">correction required</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="VR6" name="Validation complete" sourceRef="VR_DetermineOutcome" targetRef="VR_CompleteAttestation" />
    <bpmn:sequenceFlow id="VR7" sourceRef="VR_RequestEvidence" targetRef="VR_EvidenceRequestSent" />
    <bpmn:sequenceFlow id="VR8" sourceRef="VR_IssueChallenge" targetRef="VR_ChallengeSent" />
    <bpmn:sequenceFlow id="VR9" sourceRef="VR_IssueCorrection" targetRef="VR_CorrectionSent" />
    <bpmn:sequenceFlow id="VR10a" sourceRef="VR_EvidenceRequestSent" targetRef="VR_ResponseReceived" />
    <bpmn:sequenceFlow id="VR10b" sourceRef="VR_ChallengeSent" targetRef="VR_ResponseReceived" />
    <bpmn:sequenceFlow id="VR10c" sourceRef="VR_CorrectionSent" targetRef="VR_ResponseReceived" />
    <bpmn:sequenceFlow id="VR12" sourceRef="VR_ResponseReceived" targetRef="VR_EvaluateEvidence" />
    <bpmn:sequenceFlow id="VR13" sourceRef="VR_CompleteAttestation" targetRef="VR_AttestationSent" />
    <bpmn:sequenceFlow id="VR14" sourceRef="VR_AttestationSent" targetRef="VR_End" />
  </bpmn:process>
  <bpmn:process id="Process_Contributor_03" isExecutable="false">
    <bpmn:laneSet id="Lanes_Contributor_03">
      <bpmn:lane id="Lane_Contributor_03" name="Contributor Party">
        <bpmn:flowNodeRef>CT_Authorized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_SelectPolicy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_ContributionSubmitSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_JoinWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_WaitForResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_EvidenceRequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_ChallengeReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_CorrectionReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_AttestationReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_Respond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_EvidenceResubmittedSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_GovernanceInterruption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_ApplyInterruption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_Interrupted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CT_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="CT_Authorized" name="Contributor_Authorized received">
      <bpmn:outgoing>CT1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ContributorAuthorized" />
    </bpmn:startEvent>
    <bpmn:task id="CT_SelectPolicy" name="Select standard version and Observation Key policy">
      <bpmn:incoming>CT1</bpmn:incoming>
      <bpmn:outgoing>CT2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="CT_Submit" name="Submit Contribution ID, information or reference, and evidence">
      <bpmn:incoming>CT2</bpmn:incoming>
      <bpmn:outgoing>CT3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="CT_ContributionSubmitSent" name="Contribution_Submit sent">
      <bpmn:incoming>CT3</bpmn:incoming>
      <bpmn:outgoing>CT4</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ContributionSubmit" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="CT_JoinWait">
      <bpmn:incoming>CT4</bpmn:incoming>
      <bpmn:incoming>CT10</bpmn:incoming>
      <bpmn:outgoing>CT4a</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="CT_WaitForResponse" name="Wait for Verifier action or attestation">
      <bpmn:incoming>CT4a</bpmn:incoming>
      <bpmn:outgoing>CT5</bpmn:outgoing>
      <bpmn:outgoing>CT6</bpmn:outgoing>
      <bpmn:outgoing>CT7</bpmn:outgoing>
      <bpmn:outgoing>CT11</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="CT_EvidenceRequestReceived" name="Evidence_Request received">
      <bpmn:incoming>CT5</bpmn:incoming>
      <bpmn:outgoing>CT8a</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_EvidenceRequest" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="CT_ChallengeReceived" name="Challenge received">
      <bpmn:incoming>CT6</bpmn:incoming>
      <bpmn:outgoing>CT8b</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Challenge" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="CT_CorrectionReceived" name="Correction received">
      <bpmn:incoming>CT7</bpmn:incoming>
      <bpmn:outgoing>CT8c</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Correction" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="CT_AttestationReceived" name="Verifier_Attestation received">
      <bpmn:incoming>CT11</bpmn:incoming>
      <bpmn:outgoing>CT12</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_VerifierAttestation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="CT_Respond" name="Respond with evidence or correction using the contribution contract version">
      <bpmn:incoming>CT8a</bpmn:incoming>
      <bpmn:incoming>CT8b</bpmn:incoming>
      <bpmn:incoming>CT8c</bpmn:incoming>
      <bpmn:outgoing>CT9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="CT_EvidenceResubmittedSent" name="Evidence_Resubmitted sent">
      <bpmn:incoming>CT9</bpmn:incoming>
      <bpmn:outgoing>CT10</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_EvidenceResubmitted" />
    </bpmn:intermediateThrowEvent>
    <bpmn:boundaryEvent id="CT_GovernanceInterruption" name="Governance suspension or rotation arriving mid-submission" attachedToRef="CT_Submit">
      <bpmn:outgoing>CT_BI1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_GovernanceInterruption" />
    </bpmn:boundaryEvent>
    <bpmn:task id="CT_ApplyInterruption" name="Apply governance suspension or rotation">
      <bpmn:incoming>CT_BI1</bpmn:incoming>
      <bpmn:outgoing>CT_BI2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="CT_Interrupted" name="Contributor suspended or rotated by governance">
      <bpmn:incoming>CT_BI2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="CT_End" name="Contribution validation complete">
      <bpmn:incoming>CT12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CT1" sourceRef="CT_Authorized" targetRef="CT_SelectPolicy" />
    <bpmn:sequenceFlow id="CT2" sourceRef="CT_SelectPolicy" targetRef="CT_Submit" />
    <bpmn:sequenceFlow id="CT3" sourceRef="CT_Submit" targetRef="CT_ContributionSubmitSent" />
    <bpmn:sequenceFlow id="CT4" sourceRef="CT_ContributionSubmitSent" targetRef="CT_JoinWait" />
    <bpmn:sequenceFlow id="CT4a" sourceRef="CT_JoinWait" targetRef="CT_WaitForResponse" />
    <bpmn:sequenceFlow id="CT5" sourceRef="CT_WaitForResponse" targetRef="CT_EvidenceRequestReceived" />
    <bpmn:sequenceFlow id="CT6" sourceRef="CT_WaitForResponse" targetRef="CT_ChallengeReceived" />
    <bpmn:sequenceFlow id="CT7" sourceRef="CT_WaitForResponse" targetRef="CT_CorrectionReceived" />
    <bpmn:sequenceFlow id="CT8a" sourceRef="CT_EvidenceRequestReceived" targetRef="CT_Respond" />
    <bpmn:sequenceFlow id="CT8b" sourceRef="CT_ChallengeReceived" targetRef="CT_Respond" />
    <bpmn:sequenceFlow id="CT8c" sourceRef="CT_CorrectionReceived" targetRef="CT_Respond" />
    <bpmn:sequenceFlow id="CT9" sourceRef="CT_Respond" targetRef="CT_EvidenceResubmittedSent" />
    <bpmn:sequenceFlow id="CT10" sourceRef="CT_EvidenceResubmittedSent" targetRef="CT_JoinWait" />
    <bpmn:sequenceFlow id="CT11" sourceRef="CT_WaitForResponse" targetRef="CT_AttestationReceived" />
    <bpmn:sequenceFlow id="CT12" sourceRef="CT_AttestationReceived" targetRef="CT_End" />
    <bpmn:sequenceFlow id="CT_BI1" sourceRef="CT_GovernanceInterruption" targetRef="CT_ApplyInterruption" />
    <bpmn:sequenceFlow id="CT_BI2" sourceRef="CT_ApplyInterruption" targetRef="CT_Interrupted" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_03">
    <bpmndi:BPMNPlane id="Plane_03" bpmnElement="Collaboration_03">
      <bpmndi:BPMNShape id="DI_Chassis_External" bpmnElement="Participant_Chassis_External" isHorizontal="true"><dc:Bounds x="20" y="20" width="1540" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Verifier_03" bpmnElement="Participant_Verifier_03" isHorizontal="true"><dc:Bounds x="20" y="120" width="1540" height="440" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_SubmissionReceived" bpmnElement="VR_SubmissionReceived"><dc:Bounds x="100" y="260" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_EvaluateEvidence" bpmnElement="VR_EvaluateEvidence"><dc:Bounds x="180" y="250" width="220" height="56" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_DetermineOutcome" bpmnElement="VR_DetermineOutcome" isMarkerVisible="true"><dc:Bounds x="450" y="250" width="56" height="56" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_RequestEvidence" bpmnElement="VR_RequestEvidence"><dc:Bounds x="560" y="150" width="180" height="56" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_EvidenceRequestSent" bpmnElement="VR_EvidenceRequestSent"><dc:Bounds x="780" y="160" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_IssueChallenge" bpmnElement="VR_IssueChallenge"><dc:Bounds x="560" y="230" width="180" height="56" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_ChallengeSent" bpmnElement="VR_ChallengeSent"><dc:Bounds x="780" y="240" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_IssueCorrection" bpmnElement="VR_IssueCorrection"><dc:Bounds x="560" y="310" width="180" height="56" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_CorrectionSent" bpmnElement="VR_CorrectionSent"><dc:Bounds x="780" y="320" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_CompleteAttestation" bpmnElement="VR_CompleteAttestation"><dc:Bounds x="560" y="390" width="180" height="56" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_AttestationSent" bpmnElement="VR_AttestationSent"><dc:Bounds x="780" y="400" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_ResponseReceived" bpmnElement="VR_ResponseReceived"><dc:Bounds x="900" y="260" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_End" bpmnElement="VR_End"><dc:Bounds x="900" y="400" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Contributor_03" bpmnElement="Participant_Contributor_03" isHorizontal="true"><dc:Bounds x="20" y="580" width="1540" height="500" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CT_Authorized" bpmnElement="CT_Authorized"><dc:Bounds x="100" y="700" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CT_SelectPolicy" bpmnElement="CT_SelectPolicy"><dc:Bounds x="180" y="690" width="180" height="56" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CT_Submit" bpmnElement="CT_Submit"><dc:Bounds x="400" y="690" width="200" height="56" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CT_ContributionSubmitSent" bpmnElement="CT_ContributionSubmitSent"><dc:Bounds x="640" y="700" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CT_JoinWait" bpmnElement="CT_JoinWait" isMarkerVisible="true"><dc:Bounds x="700" y="690" width="56" height="56" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CT_WaitForResponse" bpmnElement="CT_WaitForResponse" isMarkerVisible="true"><dc:Bounds x="780" y="690" width="56" height="56" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CT_EvidenceRequestReceived" bpmnElement="CT_EvidenceRequestReceived"><dc:Bounds x="860" y="620" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CT_ChallengeReceived" bpmnElement="CT_ChallengeReceived"><dc:Bounds x="860" y="680" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CT_CorrectionReceived" bpmnElement="CT_CorrectionReceived"><dc:Bounds x="860" y="740" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CT_AttestationReceived" bpmnElement="CT_AttestationReceived"><dc:Bounds x="860" y="800" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CT_Respond" bpmnElement="CT_Respond"><dc:Bounds x="960" y="690" width="220" height="56" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CT_EvidenceResubmittedSent" bpmnElement="CT_EvidenceResubmittedSent"><dc:Bounds x="1220" y="700" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CT_End" bpmnElement="CT_End"><dc:Bounds x="960" y="800" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CT_GovernanceInterruption" bpmnElement="CT_GovernanceInterruption"><dc:Bounds x="482" y="780" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CT_ApplyInterruption" bpmnElement="CT_ApplyInterruption"><dc:Bounds x="400" y="860" width="200" height="56" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CT_Interrupted" bpmnElement="CT_Interrupted"><dc:Bounds x="640" y="870" width="36" height="36" /></bpmndi:BPMNShape>
