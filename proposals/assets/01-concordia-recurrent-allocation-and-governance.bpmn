    <bpmn:sequenceFlow id="Flow_097ea2e" sourceRef="Activity_0sawjhj" targetRef="Gateway_1dhia5b" />
    <bpmn:sequenceFlow id="Flow_02gmqak" name="Mechanism" sourceRef="Gateway_1dhia5b" targetRef="Event_03w5kdl" />
    <bpmn:sequenceFlow id="Flow_1bao0op" name="Token" sourceRef="Gateway_1dhia5b" targetRef="Event_18anv7q" />
    <bpmn:intermediateThrowEvent id="Event_18anv7q" name="Token Settled">
      <bpmn:incoming>Flow_1bao0op</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1trcr3n" />
    </bpmn:intermediateThrowEvent>
  </bpmn:process>
