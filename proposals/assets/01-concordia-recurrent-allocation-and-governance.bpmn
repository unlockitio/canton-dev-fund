        <di:waypoint x="460" y="660" />
        <di:waypoint x="535" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_157v3f0_di" bpmnElement="Flow_157v3f0">
        <di:waypoint x="1010" y="685" />
        <di:waypoint x="1010" y="732" />
      </bpmndi:BPMNEdge>
