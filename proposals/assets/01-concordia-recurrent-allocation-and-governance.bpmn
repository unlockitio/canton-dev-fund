<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_01_concordia_recurrent_allocation" targetNamespace="https://unlockit.io/concordia-v2/bpmn" exporter="Concordia V2 deterministic renderer" exporterVersion="1.0">
  <bpmn:message id="Message_Proposal" name="Rule proposal" />
  <bpmn:process id="Process_ConcordiaRecurrence" isExecutable="false">
    <bpmn:documentation>Illustrative BPMN for the CAP V2 allocation lifecycle between two stakeholders: Policyholder (the party who proposes the rule, governs it, triggers it, and places tokens to be settled) and Counterparty (the party who receives the rule proposal, acknowledges it, and triggers settlement of each cycle). After acknowledgement, two routes are available: a governance fix route (amend, suspend, resume, terminate the rule itself) and a rule triggering route (trigger, place token, trigger settlement, next cycle). CAP System (cap-core + cap-recurrence) executes the rule mechanics between the two stakeholder actions; it is not modelled as a lane because it is the processing substrate, not a participant. Canton Token Standard is the external settlement boundary, invoked when the Policyholder places a token and the Counterparty triggers settlement; it is not modelled as a lane because it is an external settlement standard, not a participant. cap-core carries authority for outcome execution; participant approval and signing remain authoritative. cap-recurrence defines the rule and accrual mechanics; cap-governance authorizes lifecycle changes. Settlement is an external boundary via existing Canton Token Standards; CAP does not introduce a separate token, transfer, or settlement standard. This BPMN is illustrative and does not claim implementation, payment execution, or signing authority.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_ConcordiaRecurrence">
      <bpmn:lane id="Lane_Policyholder" name="Policyholder">
        <bpmn:flowNodeRef>Start_PolicyholderDecide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Policyholder_ProposeRule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Policyholder_ProposalSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_134h1my</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1dsogex</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Counterparty" name="Counterparty">
        <bpmn:flowNodeRef>Event_Counterparty_ProposalReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Counterparty_Acknowledge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Counterparty_NextAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1ii116s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_150df0p</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1lfia3o</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_02zy9q8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_PolicyholderDecide" name="Policyholder decides to propose a recurring rule">
      <bpmn:outgoing>Flow_Start_Propose</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Policyholder_ProposeRule" name="Propose recurring rule (rate, schedule, asset, effective date)">
      <bpmn:incoming>Flow_Start_Propose</bpmn:incoming>
      <bpmn:outgoing>Flow_Propose_Throw</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="Event_Policyholder_ProposalSent" name="Rule proposal sent">
      <bpmn:incoming>Flow_Propose_Throw</bpmn:incoming>
      <bpmn:outgoing>Flow_Throw_Catch</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_Proposal" messageRef="Message_Proposal" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Event_Counterparty_ProposalReceived" name="Rule proposal received">
      <bpmn:incoming>Flow_Throw_Catch</bpmn:incoming>
      <bpmn:outgoing>Flow_Catch_Ack</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_ProposalCatch" messageRef="Message_Proposal" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_Counterparty_Acknowledge" name="Acknowledge and agree to recurring rule">
      <bpmn:incoming>Flow_Catch_Ack</bpmn:incoming>
      <bpmn:outgoing>Flow_Ack_Next</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Counterparty_NextAction" name="Trigger Rule By Whom?">
      <bpmn:incoming>Flow_Ack_Next</bpmn:incoming>
      <bpmn:outgoing>Flow_1i3dc2l</bpmn:outgoing>
      <bpmn:outgoing>Flow_15tsj0q</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Start_Propose" sourceRef="Start_PolicyholderDecide" targetRef="Task_Policyholder_ProposeRule" />
    <bpmn:sequenceFlow id="Flow_Propose_Throw" sourceRef="Task_Policyholder_ProposeRule" targetRef="Event_Policyholder_ProposalSent" />
    <bpmn:sequenceFlow id="Flow_Throw_Catch" sourceRef="Event_Policyholder_ProposalSent" targetRef="Event_Counterparty_ProposalReceived" />
    <bpmn:sequenceFlow id="Flow_Catch_Ack" sourceRef="Event_Counterparty_ProposalReceived" targetRef="Task_Counterparty_Acknowledge" />
    <bpmn:sequenceFlow id="Flow_Ack_Next" sourceRef="Task_Counterparty_Acknowledge" targetRef="Gateway_Counterparty_NextAction" />
    <bpmn:exclusiveGateway id="Gateway_02zy9q8">
      <bpmn:incoming>Flow_0iqncty</bpmn:incoming>
      <bpmn:outgoing>Flow_157v3f0</bpmn:outgoing>
      <bpmn:outgoing>Flow_08makak</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_157v3f0" sourceRef="Gateway_02zy9q8" targetRef="Event_150df0p" />
    <bpmn:task id="Activity_1lfia3o" name="Trigger recurring rule">
      <bpmn:incoming>Flow_15tsj0q</bpmn:incoming>
      <bpmn:outgoing>Flow_0iqncty</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1i3dc2l" name="Propose Policy Change By Whom?" sourceRef="Gateway_Counterparty_NextAction" targetRef="Event_1ii116s" />
    <bpmn:intermediateThrowEvent id="Event_1ii116s">
      <bpmn:incoming>Flow_1i3dc2l</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1owlklc" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Event_134h1my" name="Trigger Rule Received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_057odhn" messageRef="Message_Proposal" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_0iqncty" sourceRef="Activity_1lfia3o" targetRef="Gateway_02zy9q8" />
    <bpmn:intermediateThrowEvent id="Event_1dsogex">
      <bpmn:incoming>Flow_08makak</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0gwcfsc" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_150df0p">
      <bpmn:incoming>Flow_157v3f0</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_02060ce" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_15tsj0q" sourceRef="Gateway_Counterparty_NextAction" targetRef="Activity_1lfia3o" />
    <bpmn:sequenceFlow id="Flow_08makak" sourceRef="Gateway_02zy9q8" targetRef="Event_1dsogex" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ConcordiaRecurrence">
    <bpmndi:BPMNPlane id="BPMNPlane_ConcordiaRecurrence" bpmnElement="Process_ConcordiaRecurrence">
