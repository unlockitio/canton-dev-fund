        <bpmndi:BPMNLabel>
          <dc:Bounds x="280" y="690" width="180" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Counterparty_NextAction_di" bpmnElement="Gateway_Counterparty_NextAction" isMarkerVisible="true">
        <dc:Bounds x="535" y="635" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="591" y="627" width="77" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0uyt060_di" bpmnElement="Event_1ii116s">
        <dc:Bounds x="642" y="772" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_0iy4kz7" bpmnElement="Event_134h1my">
        <dc:Bounds x="200" y="230" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="190" y="280" width="61" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_06cyaxj_di" bpmnElement="Event_1dsogex">
        <dc:Bounds x="992" y="492" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_03hwqx3_di" bpmnElement="Event_150df0p">
        <dc:Bounds x="992" y="732" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_1dmxu2g" bpmnElement="Activity_1lfia3o">
        <dc:Bounds x="690" y="620" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_02zy9q8_di" bpmnElement="Gateway_02zy9q8" isMarkerVisible="true">
        <dc:Bounds x="985" y="635" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Propose_di" bpmnElement="Flow_Start_Propose">
        <di:waypoint x="240" y="100" />
        <di:waypoint x="320" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Propose_Throw_di" bpmnElement="Flow_Propose_Throw">
        <di:waypoint x="460" y="100" />
