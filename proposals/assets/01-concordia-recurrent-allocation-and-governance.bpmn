    <bpmn:sequenceFlow id="Flow_0invovx" name="Rejected" sourceRef="Gateway_0ykcahn" targetRef="Event_0mqofvm" />
    <bpmn:sequenceFlow id="Flow_1y2jylr" sourceRef="Event_0thxcaq" targetRef="Activity_0wlrtnj" />
