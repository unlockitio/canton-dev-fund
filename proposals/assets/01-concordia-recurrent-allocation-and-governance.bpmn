      <bpmndi:BPMNEdge id="Flow_0iqncty_di" bpmnElement="Flow_0iqncty">
        <di:waypoint x="790" y="660" />
        <di:waypoint x="985" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15tsj0q_di" bpmnElement="Flow_15tsj0q">
        <di:waypoint x="585" y="660" />
