        <bpmndi:BPMNLabel>
          <dc:Bounds x="315" y="751" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_R2" bpmnElement="R2">
        <di:waypoint x="368" y="733" />
        <di:waypoint x="570" y="733" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_R3" bpmnElement="R3">
        <di:waypoint x="760" y="733" />
        <di:waypoint x="930" y="733" />
      </bpmndi:BPMNEdge>
