      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_C2" bpmnElement="C2">
        <di:waypoint x="670" y="498" />
        <di:waypoint x="850" y="498" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="DI_Participant_Resolver" bpmnElement="Participant_Resolver" isHorizontal="true">
        <dc:Bounds x="20" y="620" width="1540" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_A_EvaluateResolve" bpmnElement="A_EvaluateResolve">
        <dc:Bounds x="570" y="695" width="190" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_A_ElectionOutcome" bpmnElement="A_ElectionOutcome" isMarkerVisible="true">
        <dc:Bounds x="930" y="705" width="56" height="56" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="917" y="761" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_A_ConsortiumFormed" bpmnElement="A_ConsortiumFormed">
        <dc:Bounds x="1110" y="650" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1100" y="686" width="57" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_A_VRejected" bpmnElement="A_VRejected">
        <dc:Bounds x="1110" y="715" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1103" y="751" width="51" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
