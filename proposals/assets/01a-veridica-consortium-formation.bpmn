      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Assoc_A_DecisionPolicies" bpmnElement="Assoc_A_DecisionPolicies">
        <di:waypoint x="775" y="90" />
        <di:waypoint x="775" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="DI_Participant_Candidates" bpmnElement="Participant_Candidates" isHorizontal="true">
        <dc:Bounds x="20" y="410" width="1540" height="180" />
