<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_01a_veridica_consortium_formation" targetNamespace="https://unlockit.io/veridica/bpmn" exporter="Veridica deterministic renderer" exporterVersion="4.0">
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Participant_Lead" name="Consortium Lead (Genesis Proposer)" processRef="Process_Lead" />
    <bpmn:participant id="Participant_Candidates" name="Fixed Candidate (multi-instance, one per committed Candidate)" processRef="Process_Candidates" />
    <bpmn:participant id="Participant_Resolver" name="Genesis Resolver" processRef="Process_Resolver" />
    <bpmn:messageFlow id="Message_Proposal" name="Genesis Proposal + Ballot Request" sourceRef="A_ProposalDelivered" targetRef="A_RequestReceived" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Lead" isExecutable="false">
    <bpmn:startEvent id="A_Start" name="Start">
      <bpmn:outgoing>A1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="A_PartySetup" name="Execution identity requires Party setup?" gatewayDirection="Diverging">
      <bpmn:incoming>A1</bpmn:incoming>
      <bpmn:outgoing>A2_Yes</bpmn:outgoing>
      <bpmn:outgoing>A2_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_PartyCreated" name="Create or register required Party">
      <bpmn:incoming>A2_Yes</bpmn:incoming>
      <bpmn:outgoing>A3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="A_PartyMerge" gatewayDirection="Converging">
      <bpmn:incoming>A2_No</bpmn:incoming>
      <bpmn:incoming>A3</bpmn:incoming>
      <bpmn:outgoing>A4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_ProposeConsortium" name="Propose Consortium">
      <bpmn:incoming>A4</bpmn:incoming>
      <bpmn:outgoing>A6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1yqremm">
        <bpmn:targetRef>DataObjectReference_1cx3e06</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="A1" sourceRef="A_Start" targetRef="A_PartySetup" />
    <bpmn:sequenceFlow id="A2_Yes" name="Yes: DecMan Governor Party or single Consortium Party" sourceRef="A_PartySetup" targetRef="A_PartyCreated" />
    <bpmn:sequenceFlow id="A2_No" name="No: Use committed Proposer + Candidate Party set" sourceRef="A_PartySetup" targetRef="A_PartyMerge" />
    <bpmn:sequenceFlow id="A3" sourceRef="A_PartyCreated" targetRef="A_PartyMerge" />
    <bpmn:sequenceFlow id="A4" sourceRef="A_PartyMerge" targetRef="A_ProposeConsortium" />
    <bpmn:sequenceFlow id="A6" sourceRef="A_ProposeConsortium" targetRef="A_SendProposal" />
    <bpmn:sequenceFlow id="A7" sourceRef="A_SendProposal" targetRef="A_ProposalDelivered" />
    <bpmn:dataObjectReference id="DataObjectReference_1cx3e06" name="Genesis Proposal" dataObjectRef="DataObject_0jxqfhw" />
    <bpmn:dataObject id="DataObject_0jxqfhw" />
    <bpmn:task id="A_SendProposal" name="Send Genesis Proposal + Ballot Request to every fixed Candidate">
      <bpmn:incoming>A6</bpmn:incoming>
      <bpmn:outgoing>A7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="A_ProposalDelivered" name="Proposal delivered">
      <bpmn:incoming>A7</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1l1pgn1" />
    </bpmn:intermediateThrowEvent>
    <bpmn:textAnnotation id="A_DecisionPolicies">
      <bpmn:text>Uses the Party Setup result to define and commit the execution identity/model, decision-policy fields, and fixed closed Candidate electorate.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_A_DecisionPolicies" sourceRef="A_DecisionPolicies" targetRef="A_ProposeConsortium" />
  </bpmn:process>
  <bpmn:process id="Process_Candidates" isExecutable="false">
    <bpmn:sequenceFlow id="C1" sourceRef="A_RequestReceived" targetRef="A_SubmitBallot" />
    <bpmn:sequenceFlow id="C2" sourceRef="A_SubmitBallot" targetRef="A_BallotSubmitted" />
    <bpmn:startEvent id="A_RequestReceived" name="Request received">
      <bpmn:outgoing>C1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="A_SubmitBallot" name="Submit own ballot">
      <bpmn:incoming>C1</bpmn:incoming>
      <bpmn:outgoing>C2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="A_BallotSubmitted" name="Ballot submitted">
      <bpmn:incoming>C2</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1dd3ors" />
    </bpmn:intermediateThrowEvent>
  </bpmn:process>
  <bpmn:process id="Process_Resolver" isExecutable="false">
    <bpmn:sequenceFlow id="R2" sourceRef="A_ReceiveBallots" targetRef="A_EvaluateResolve" />
    <bpmn:sequenceFlow id="R3" sourceRef="A_EvaluateResolve" targetRef="A_ElectionOutcome" />
    <bpmn:sequenceFlow id="R4" sourceRef="A_ElectionOutcome" targetRef="A_ConsortiumFormed" />
    <bpmn:sequenceFlow id="R5" sourceRef="A_ElectionOutcome" targetRef="A_VRejected" />
    <bpmn:sequenceFlow id="R6" sourceRef="A_ElectionOutcome" targetRef="A_VExpired" />
    <bpmn:task id="A_EvaluateResolve" name="Evaluate and resolve genesis election">
      <bpmn:incoming>R2</bpmn:incoming>
      <bpmn:outgoing>R3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="A_ElectionOutcome" name="Genesis election outcome" gatewayDirection="Diverging">
      <bpmn:incoming>R3</bpmn:incoming>
      <bpmn:outgoing>R4</bpmn:outgoing>
      <bpmn:outgoing>R5</bpmn:outgoing>
      <bpmn:outgoing>R6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="A_ConsortiumFormed" name="Consortium formed">
      <bpmn:incoming>R4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="A_VRejected" name="VRejected">
      <bpmn:incoming>R5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="A_VExpired" name="VExpired">
      <bpmn:incoming>R6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="A_ReceiveBallots" name="Genesis ballot received">
      <bpmn:outgoing>R2</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="ConditionalEventDefinition_1a5xgcl">
        <bpmn:condition xsi:type="bpmn:tFormalExpression" />
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="DI_Participant_Lead" bpmnElement="Participant_Lead" isHorizontal="true">
        <dc:Bounds x="20" y="30" width="1540" height="360" />
