        <dc:Bounds x="1005" y="110" width="190" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_10jy2o2_di" bpmnElement="A_ProposalDelivered">
        <dc:Bounds x="1342" y="130" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1337" y="93" width="45" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_A_DecisionPolicies" bpmnElement="A_DecisionPolicies">
        <dc:Bounds x="630" y="45" width="270" height="45" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_A1" bpmnElement="A1">
        <di:waypoint x="136" y="144" />
        <di:waypoint x="200" y="144" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_A2_Yes" bpmnElement="A2_Yes">
        <di:waypoint x="228" y="120" />
