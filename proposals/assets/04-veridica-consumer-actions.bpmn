<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Workflow04" targetNamespace="https://unlockit.io/veridica/bpmn" exporter="Veridica deterministic renderer" exporterVersion="4.0">
  <bpmn:message id="Message_QuoteRequest" name="Quote request" />
  <bpmn:message id="Message_BindingQuote" name="Binding time-bound quote" />
  <bpmn:message id="Message_AcceptedQuoteFunding" name="Accepted quote and funding instruction" />
  <bpmn:message id="Message_FundingSecured" name="Funding secured" />
  <bpmn:message id="Message_AllocationInputs" name="Allocation inputs" />
  <bpmn:message id="Message_ExecutionEvidence" name="Execution-complete evidence" />
  <bpmn:message id="Message_FinalReceipt" name="Final settlement receipt" />
  <bpmn:message id="Message_SelectedData" name="Selected data" />
  <bpmn:collaboration id="Collaboration_Workflow04">
    <bpmn:participant id="Participant_Consumer" name="Consumer" processRef="Process_Consumer" />
    <bpmn:participant id="Participant_DataProvider" name="Data Provider" processRef="Process_DataProvider" />
    <bpmn:participant id="Participant_SettlementAllocator" name="Settlement Allocator" processRef="Process_SettlementAllocator" />
    <bpmn:participant id="Participant_Escrow" name="Escrow" processRef="Process_Escrow" />
    <bpmn:messageFlow id="MessageFlow_QuoteRequest" sourceRef="Consumer_SendQuoteRequest" targetRef="Provider_ReceiveQuoteRequest" />
    <bpmn:messageFlow id="MessageFlow_BindingQuote" sourceRef="Provider_SendBindingQuote" targetRef="Consumer_ReceiveBindingQuote" />
    <bpmn:messageFlow id="MessageFlow_AcceptedQuoteFunding" sourceRef="Consumer_SendAcceptedQuoteFunding" targetRef="Provider_ReceiveFundingSecured" />
    <bpmn:messageFlow id="MessageFlow_AllocationInputs" sourceRef="Provider_SendAllocationInputs" targetRef="Allocator_ReceiveAllocationInputs" />
    <bpmn:messageFlow id="MessageFlow_ExecutionEvidence" sourceRef="Allocator_SendExecutionEvidence" targetRef="Escrow_ReceiveExecutionEvidence" />
    <bpmn:textAnnotation id="Annotation_ConfiguredRoutes">
      <bpmn:text>Configured route: stablecoin, same-standard internal-token credit, or fiat rail. Fiat execution record requires configured connector/rail confirmation.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_AllocationInputs">
      <bpmn:text>Prepared data/product ref; quote/funding ref; applicable policy</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_AllocationInputs" sourceRef="Provider_PrepareSelectedData" targetRef="Annotation_AllocationInputs" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Consumer" name="Consumer actions" isExecutable="false">
    <bpmn:task id="Consumer_SelectData" name="Select single data point or aggregation">
      <bpmn:incoming>C_Flow_01</bpmn:incoming>
      <bpmn:outgoing>C_Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="Consumer_Start" name="Data needed">
      <bpmn:outgoing>C_Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="C_Flow_02" sourceRef="Consumer_SelectData" targetRef="Consumer_SendQuoteRequest" />
    <bpmn:sequenceFlow id="C_Flow_01" sourceRef="Consumer_Start" targetRef="Consumer_SelectData" />
    <bpmn:intermediateCatchEvent id="Consumer_ReceiveBindingQuote" name="Receive binding quote">
      <bpmn:outgoing>C_Flow_04</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_BindingQuote" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Consumer_AcceptQuote" name="Accept quote and lock token">
      <bpmn:incoming>C_Flow_04</bpmn:incoming>
      <bpmn:outgoing>C_Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="C_Flow_04" sourceRef="Consumer_ReceiveBindingQuote" targetRef="Consumer_AcceptQuote" />
    <bpmn:sequenceFlow id="C_Flow_05" sourceRef="Consumer_AcceptQuote" targetRef="Consumer_SendAcceptedQuoteFunding" />
    <bpmn:intermediateThrowEvent id="Consumer_SendQuoteRequest" name="Request binding time-bound quote">
      <bpmn:incoming>C_Flow_02</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_QuoteRequest" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Consumer_SendAcceptedQuoteFunding" name="Send accepted quote and funding instruction">
      <bpmn:incoming>C_Flow_05</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_AcceptedQuoteFunding" />
    </bpmn:intermediateThrowEvent>
  </bpmn:process>
  <bpmn:process id="Process_DataProvider" name="Data Provider actions" isExecutable="false">
    <bpmn:task id="Provider_PrepareBindingQuote" name="Prepare binding time-bound quote">
      <bpmn:incoming>P_Flow_01</bpmn:incoming>
      <bpmn:outgoing>P_Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="Provider_ReceiveQuoteRequest" name="Receive quote request">
      <bpmn:outgoing>P_Flow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_QuoteRequest" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="P_Flow_02" sourceRef="Provider_PrepareBindingQuote" targetRef="Provider_SendBindingQuote" />
    <bpmn:sequenceFlow id="P_Flow_01" sourceRef="Provider_ReceiveQuoteRequest" targetRef="Provider_PrepareBindingQuote" />
    <bpmn:startEvent id="Provider_ReceiveFundingSecured" name="Funding secured">
      <bpmn:outgoing>P_Flow_04</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_FundingSecured" />
    </bpmn:startEvent>
    <bpmn:task id="Provider_PrepareSelectedData" name="Prepare selected data">
      <bpmn:incoming>P_Flow_04</bpmn:incoming>
      <bpmn:outgoing>P_Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="P_Flow_04" sourceRef="Provider_ReceiveFundingSecured" targetRef="Provider_PrepareSelectedData" />
    <bpmn:sequenceFlow id="P_Flow_05" sourceRef="Provider_PrepareSelectedData" targetRef="Provider_SendAllocationInputs" />
    <bpmn:intermediateThrowEvent id="Provider_SendBindingQuote" name="Return binding quote">
      <bpmn:incoming>P_Flow_02</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_BindingQuote" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Provider_SendAllocationInputs" name="Send allocation inputs">
      <bpmn:incoming>P_Flow_05</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_AllocationInputs" />
    </bpmn:intermediateThrowEvent>
  </bpmn:process>
  <bpmn:process id="Process_SettlementAllocator" name="Settlement Allocator actions" isExecutable="false">
    <bpmn:startEvent id="Allocator_ReceiveAllocationInputs" name="Receive allocation inputs">
      <bpmn:outgoing>A_Flow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_AllocationInputs" />
    </bpmn:startEvent>
    <bpmn:task id="Allocator_GenerateInstructions" name="Generate immutable N recipient settlement instructions">
      <bpmn:incoming>A_Flow_01</bpmn:incoming>
      <bpmn:outgoing>A_Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="Allocator_SendExecutionEvidence" name="Send execution-complete evidence">
      <bpmn:incoming>A_Flow_03</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_ExecutionEvidence" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="A_Flow_01" sourceRef="Allocator_ReceiveAllocationInputs" targetRef="Allocator_GenerateInstructions" />
    <bpmn:sequenceFlow id="A_Flow_02" sourceRef="Allocator_GenerateInstructions" targetRef="Allocator_AllocateEachInstruction" />
    <bpmn:sequenceFlow id="A_Flow_03" sourceRef="Allocator_AllocateEachInstruction" targetRef="Allocator_SendExecutionEvidence" />
    <bpmn:subProcess id="Allocator_AllocateEachInstruction" name="Allocate and record each configured recipient instruction">
      <bpmn:incoming>A_Flow_02</bpmn:incoming>
      <bpmn:outgoing>A_Flow_03</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
    </bpmn:subProcess>
    <bpmn:association id="Association_ConfiguredRoutes" sourceRef="Allocator_AllocateEachInstruction" targetRef="Annotation_ConfiguredRoutes" />
  </bpmn:process>
  <bpmn:process id="Process_Escrow" name="Escrow actions" isExecutable="false">
    <bpmn:intermediateCatchEvent id="Escrow_ReceiveExecutionEvidence" name="Receive execution-complete evidence">
      <bpmn:outgoing>E_Flow_04</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ExecutionEvidence" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Escrow_VerifyExecutionRecords" name="Verify all N execution records">
      <bpmn:incoming>E_Flow_04</bpmn:incoming>
      <bpmn:outgoing>E_Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="E_Flow_04" sourceRef="Escrow_ReceiveExecutionEvidence" targetRef="Escrow_VerifyExecutionRecords" />
    <bpmn:sequenceFlow id="E_Flow_05" sourceRef="Escrow_VerifyExecutionRecords" targetRef="Escrow_PerformFinalSettlement" />
    <bpmn:sequenceFlow id="E_Flow_06" sourceRef="Escrow_PerformFinalSettlement" targetRef="Event_1b3jz6z" />
    <bpmn:task id="Escrow_PerformFinalSettlement" name="Perform final settlement">
      <bpmn:incoming>E_Flow_05</bpmn:incoming>
      <bpmn:outgoing>E_Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_1b3jz6z">
      <bpmn:incoming>E_Flow_06</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0yz1m70" />
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Workflow04">
    <bpmndi:BPMNPlane id="BPMNPlane_Workflow04" bpmnElement="Collaboration_Workflow04">
