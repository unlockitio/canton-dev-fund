<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Veridica_DataProducerActions" targetNamespace="https://veridica.example/bpmn" exporter="Veridica deterministic renderer" exporterVersion="5.0">
  <bpmn:message id="Message_ContributionVersion" name="Contribution" />
  <bpmn:message id="Message_CorrectionRequest" name="Correction request" />
  <bpmn:collaboration id="Collaboration_Veridica_DataProducerActions" name="03 Veridica Data Producer Actions">
    <bpmn:documentation>Contributor, Aggregator, and Verifier are independent participants. Each initial or corrected contribution follows one simple submission path and is delivered through two point-to-point message flows, one to Aggregator and one to Verifier. Correction preserves prior-version evidence as not current and requiring revalidation. The Verifier validates contribution artifacts and evidence and verifies the consolidated artifact, never the Aggregator's work, performance, or method.</bpmn:documentation>
    <bpmn:participant id="Participant_Contributor" name="Contributor" processRef="Process_Contributor" />
    <bpmn:participant id="Participant_Aggregator" name="Aggregator" processRef="Process_Aggregator" />
    <bpmn:participant id="Participant_Verifier" name="Verifier" processRef="Process_Verifier" />
    <bpmn:messageFlow id="MF_ContributionToAggregator" sourceRef="C_SubmissionSent" targetRef="A_CatchContribution" />
    <bpmn:messageFlow id="MF_ContributionToVerifier" sourceRef="C_SubmissionSent" targetRef="V_CatchContribution" />
    <bpmn:messageFlow id="MF_CorrectedToAggregator" sourceRef="C_CorrectedSubmissionSent" targetRef="A_CatchContribution" />
    <bpmn:messageFlow id="MF_CorrectedToVerifier" sourceRef="C_CorrectedSubmissionSent" targetRef="V_CatchContribution" />
    <bpmn:messageFlow id="MF_CorrectionRequest" sourceRef="A_ThrowCorrection" targetRef="C_CatchCorrection" />
    <bpmn:messageFlow id="MF_ConsolidatedContribution" sourceRef="A_ThrowConsolidated" targetRef="V_CatchContribution" />
    <bpmn:textAnnotation id="Note_Correction">
      <bpmn:text>Correction creates a superseding version. The prior version and linked verification remain visible evidence marked not current / revalidation required. The corrected version is sent to both Aggregator and Verifier for fresh validation.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Correction" sourceRef="C_ResolveCorrection" targetRef="Note_Correction" />
    <bpmn:textAnnotation id="Note_Validation">
      <bpmn:text>The contribution may itself be consolidated from multiple contributors. The Verifier validates the contribution or artifact and its evidence, including traceability and applicable rules, not the Aggregator's work, method, or performance. A corrected version requires fresh validation; prior verification remains linked as not current / revalidation required.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Submission">
      <bpmn:text>Each version carries its Contribution ID, version, Observation Key, governed standard and policy versions, provenance, evidence, and any corrects or replaces reference. One simple sender event fans out through two declared point-to-point message flows.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Submission" sourceRef="C_Submit" targetRef="Note_Submission" />
    <bpmn:textAnnotation id="Note_Matching">
      <bpmn:text>Matching uses the named versioned exact or semantic Matching Policy. Mismatch, ambiguity, stale validation, or another relevant issue takes the correction route. Only current versions with fresh validation may be used.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Matching" sourceRef="A_MatchContributions" targetRef="Note_Matching" />
    <bpmn:textAnnotation id="Note_Aggregation">
      <bpmn:text>Normalize matched current versions under the named Information Standard and Aggregation Policy, apply governed calculation and confidence rules, and preserve traceability in the consolidated artifact and its evidence.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Aggregation" sourceRef="A_AggregateContributions" targetRef="Note_Aggregation" />
    <bpmn:association id="Assoc_Validation" sourceRef="V_ValidateContribution" targetRef="Note_Validation" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Contributor" name="Contributor submission" isExecutable="false">
    <bpmn:startEvent id="C_CatchCorrection" name="Correction request received">
      <bpmn:outgoing>C_F4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_MessageEvent_CorrectionCatch" messageRef="Message_CorrectionRequest" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="C_F4" sourceRef="C_CatchCorrection" targetRef="C_ResolveCorrection" />
    <bpmn:sequenceFlow id="C_F5" sourceRef="C_ResolveCorrection" targetRef="C_CorrectedSubmissionSent" />
    <bpmn:task id="C_ResolveCorrection" name="Resolve/correct contribution">
      <bpmn:incoming>C_F4</bpmn:incoming>
      <bpmn:outgoing>C_F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="C_CorrectedSubmissionSent" name="Corrected submission sent">
      <bpmn:incoming>C_F5</bpmn:incoming>
      <bpmn:messageEventDefinition id="C_CorrectedSubmissionMessage" messageRef="Message_ContributionVersion" />
    </bpmn:endEvent>
    <bpmn:startEvent id="C_Start" name="Contribution ready">
      <bpmn:outgoing>C_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="C_Submit" name="Submit contribution">
      <bpmn:incoming>C_F1</bpmn:incoming>
      <bpmn:outgoing>C_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="C_SubmissionSent" name="Submission sent">
      <bpmn:incoming>C_F2</bpmn:incoming>
      <bpmn:messageEventDefinition id="C_SubmissionMessage" messageRef="Message_ContributionVersion" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="C_F1" sourceRef="C_Start" targetRef="C_Submit" />
    <bpmn:sequenceFlow id="C_F2" sourceRef="C_Submit" targetRef="C_SubmissionSent" />
  </bpmn:process>
  <bpmn:process id="Process_Aggregator" name="Aggregator matching and consolidation" isExecutable="false">
    <bpmn:intermediateCatchEvent id="A_CatchContribution" name="Contribution received">
      <bpmn:outgoing>A_F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="A_MessageEvent_ContributionCatch" messageRef="Message_ContributionVersion" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="A_CorrectionNeeded" name="Correction needed?" gatewayDirection="Diverging">
      <bpmn:incoming>A_F2</bpmn:incoming>
      <bpmn:outgoing>A_F4Yes</bpmn:outgoing>
      <bpmn:outgoing>A_F4No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="A_F1" sourceRef="A_CatchContribution" targetRef="A_MatchContributions" />
    <bpmn:sequenceFlow id="A_F2" sourceRef="A_MatchContributions" targetRef="A_CorrectionNeeded" />
    <bpmn:sequenceFlow id="A_F4Yes" name="Yes" sourceRef="A_CorrectionNeeded" targetRef="A_InitiateCorrection" />
    <bpmn:sequenceFlow id="A_F4No" name="No" sourceRef="A_CorrectionNeeded" targetRef="A_AggregateContributions" />
    <bpmn:sequenceFlow id="A_F5" sourceRef="A_InitiateCorrection" targetRef="A_ThrowCorrection" />
    <bpmn:sequenceFlow id="A_F6" sourceRef="A_AggregateContributions" targetRef="A_ThrowConsolidated" />
    <bpmn:task id="A_MatchContributions" name="Match contributions">
      <bpmn:incoming>A_F1</bpmn:incoming>
      <bpmn:outgoing>A_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_InitiateCorrection" name="Initiate correction flow">
      <bpmn:incoming>A_F4Yes</bpmn:incoming>
      <bpmn:outgoing>A_F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="A_ThrowCorrection" name="Send correction request">
      <bpmn:incoming>A_F5</bpmn:incoming>
      <bpmn:messageEventDefinition id="A_MessageEvent_CorrectionThrow" messageRef="Message_CorrectionRequest" />
    </bpmn:endEvent>
    <bpmn:task id="A_AggregateContributions" name="Aggregate into consolidated contribution">
      <bpmn:incoming>A_F4No</bpmn:incoming>
      <bpmn:outgoing>A_F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="A_ThrowConsolidated" name="Send consolidated contribution">
      <bpmn:incoming>A_F6</bpmn:incoming>
      <bpmn:messageEventDefinition id="A_MessageEvent_ConsolidatedThrow" messageRef="Message_ContributionVersion" />
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_Verifier" name="Verifier validation" isExecutable="false">
    <bpmn:intermediateCatchEvent id="V_CatchContribution" name="Contribution received">
      <bpmn:outgoing>V_F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="V_MessageEvent_ContributionCatch" messageRef="Message_ContributionVersion" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="V_EndValidation" name="Validation recorded">
      <bpmn:incoming>V_F2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="V_ValidateContribution" name="Validate contribution and evidence">
      <bpmn:incoming>V_F1</bpmn:incoming>
      <bpmn:outgoing>V_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="V_F1" sourceRef="V_CatchContribution" targetRef="V_ValidateContribution" />
    <bpmn:sequenceFlow id="V_F2" sourceRef="V_ValidateContribution" targetRef="V_EndValidation" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_DataProducerActions">
    <bpmndi:BPMNPlane id="Plane_DataProducerActions" bpmnElement="Collaboration_Veridica_DataProducerActions">
      <bpmndi:BPMNShape id="Shape_Participant_Contributor" bpmnElement="Participant_Contributor" isHorizontal="true">
