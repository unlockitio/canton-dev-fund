<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Veridica_DataProducerActions" targetNamespace="https://unlockit.io/veridica/bpmn">
  <bpmn:signal id="Signal_ContributorAuthorized" name="Contributor_Authorized"/>
  <bpmn:signal id="Signal_AggregatorAuthorized" name="Aggregator_Authorized"/>
  <bpmn:signal id="Signal_VerifierAuthorized" name="Verifier_Authorized"/>
  <bpmn:signal id="Signal_ContributionSubmit" name="Contribution_Submit"/>
  <bpmn:signal id="Signal_EvidenceRequest" name="Evidence_Request"/>
  <bpmn:signal id="Signal_Challenge" name="Challenge"/>
  <bpmn:signal id="Signal_Correction" name="Correction"/>
  <bpmn:signal id="Signal_EvidenceResubmitted" name="Evidence_Resubmitted"/>
  <bpmn:signal id="Signal_VerifierAttestation" name="Verifier_Attestation"/>
  <bpmn:signal id="Signal_InputRequested" name="Input_Requested"/>
  <bpmn:signal id="Signal_InputReady" name="Input_Ready"/>
  <bpmn:signal id="Signal_VerificationRequest" name="Verification_Request"/>
  <bpmn:signal id="Signal_ReviewComplete" name="Review_Complete"/>
  <bpmn:signal id="Signal_AggregateCorrection" name="Correction_Received"/>
  <bpmn:message id="Message_GovernanceInterruption" name="Governance interruption"/>

  <bpmn:process id="Process_Veridica_DataProducerActions" name="03 Veridica Data Producer Actions" isExecutable="false">
    <bpmn:documentation>Authorized Contributor, Aggregator, and Verifier producers act independently. Each signal handoff is correlated to the intended party, product, contribution or aggregation round, and applicable contract or policy version; signals do not represent unscoped broadcast behavior. A contributor cannot verify its own contribution where independence is required. The same party cannot be Aggregator and Verifier for the same product. Matching, confidence, and aggregation remain policy-defined and versioned and do not prove truth or quality.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_DataProducers">
      <bpmn:lane id="Lane_Contributor" name="Contributor">
        <bpmn:flowNodeRef>C_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>C_SelectPolicy</bpmn:flowNodeRef><bpmn:flowNodeRef>C_Submit</bpmn:flowNodeRef><bpmn:flowNodeRef>C_ThrowSubmit</bpmn:flowNodeRef><bpmn:flowNodeRef>C_WaitResponse</bpmn:flowNodeRef><bpmn:flowNodeRef>C_CatchEvidence</bpmn:flowNodeRef><bpmn:flowNodeRef>C_CatchChallenge</bpmn:flowNodeRef><bpmn:flowNodeRef>C_CatchCorrection</bpmn:flowNodeRef><bpmn:flowNodeRef>C_CatchAttestation</bpmn:flowNodeRef><bpmn:flowNodeRef>C_Respond</bpmn:flowNodeRef><bpmn:flowNodeRef>C_ThrowResubmitted</bpmn:flowNodeRef><bpmn:flowNodeRef>C_End</bpmn:flowNodeRef><bpmn:flowNodeRef>C_InputStart</bpmn:flowNodeRef><bpmn:flowNodeRef>C_PrepareInput</bpmn:flowNodeRef><bpmn:flowNodeRef>C_ThrowInputReady</bpmn:flowNodeRef><bpmn:flowNodeRef>C_InputEnd</bpmn:flowNodeRef><bpmn:flowNodeRef>C_Governance</bpmn:flowNodeRef><bpmn:flowNodeRef>C_ApplyGovernance</bpmn:flowNodeRef><bpmn:flowNodeRef>C_Suspended</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Aggregator" name="Aggregator">
        <bpmn:flowNodeRef>A_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>A_PublishAvailability</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Match</bpmn:flowNodeRef><bpmn:flowNodeRef>A_ManualReview</bpmn:flowNodeRef><bpmn:flowNodeRef>A_InviteVerifier</bpmn:flowNodeRef><bpmn:flowNodeRef>A_ThrowInputRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>A_CatchInputReady</bpmn:flowNodeRef><bpmn:flowNodeRef>A_SelectInputs</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Normalize</bpmn:flowNodeRef><bpmn:flowNodeRef>A_HandleQuality</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Calculate</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Revise</bpmn:flowNodeRef><bpmn:flowNodeRef>A_ThrowVerification</bpmn:flowNodeRef><bpmn:flowNodeRef>A_WaitReview</bpmn:flowNodeRef><bpmn:flowNodeRef>A_CatchReview</bpmn:flowNodeRef><bpmn:flowNodeRef>A_CatchCorrection</bpmn:flowNodeRef><bpmn:flowNodeRef>A_PublishAggregate</bpmn:flowNodeRef><bpmn:flowNodeRef>A_End</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Governance</bpmn:flowNodeRef><bpmn:flowNodeRef>A_ApplyGovernance</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Suspended</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Verifier" name="Verifier">
        <bpmn:flowNodeRef>V_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>V_WaitWork</bpmn:flowNodeRef><bpmn:flowNodeRef>V_CatchContribution</bpmn:flowNodeRef><bpmn:flowNodeRef>V_CatchResubmitted</bpmn:flowNodeRef><bpmn:flowNodeRef>V_EvaluateContribution</bpmn:flowNodeRef><bpmn:flowNodeRef>V_ContributionOutcome</bpmn:flowNodeRef><bpmn:flowNodeRef>V_RequestEvidence</bpmn:flowNodeRef><bpmn:flowNodeRef>V_Challenge</bpmn:flowNodeRef><bpmn:flowNodeRef>V_Correct</bpmn:flowNodeRef><bpmn:flowNodeRef>V_Attest</bpmn:flowNodeRef><bpmn:flowNodeRef>V_CatchVerification</bpmn:flowNodeRef><bpmn:flowNodeRef>V_ValidateAggregate</bpmn:flowNodeRef><bpmn:flowNodeRef>V_AggregateOutcome</bpmn:flowNodeRef><bpmn:flowNodeRef>V_CompleteReview</bpmn:flowNodeRef><bpmn:flowNodeRef>V_AggregateCorrection</bpmn:flowNodeRef><bpmn:flowNodeRef>V_Governance</bpmn:flowNodeRef><bpmn:flowNodeRef>V_ApplyGovernance</bpmn:flowNodeRef><bpmn:flowNodeRef>V_Suspended</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="C_Start" name="Contributor_Authorized"><bpmn:signalEventDefinition signalRef="Signal_ContributorAuthorized"/></bpmn:startEvent>
    <bpmn:task id="C_SelectPolicy" name="Select standard version and Observation Key policy"/>
    <bpmn:task id="C_Submit" name="Submit Contribution ID, information or reference, provenance, and evidence"/>
    <bpmn:intermediateThrowEvent id="C_ThrowSubmit" name="Contribution_Submit"><bpmn:signalEventDefinition signalRef="Signal_ContributionSubmit"/></bpmn:intermediateThrowEvent>
    <bpmn:eventBasedGateway id="C_WaitResponse" name="Wait for Verifier action"/>
    <bpmn:intermediateCatchEvent id="C_CatchEvidence" name="Evidence_Request"><bpmn:signalEventDefinition signalRef="Signal_EvidenceRequest"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="C_CatchChallenge" name="Challenge"><bpmn:signalEventDefinition signalRef="Signal_Challenge"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="C_CatchCorrection" name="Correction"><bpmn:signalEventDefinition signalRef="Signal_Correction"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="C_CatchAttestation" name="Verifier_Attestation"><bpmn:signalEventDefinition signalRef="Signal_VerifierAttestation"/></bpmn:intermediateCatchEvent>
    <bpmn:task id="C_Respond" name="Respond using the submission contract version"/>
    <bpmn:intermediateThrowEvent id="C_ThrowResubmitted" name="Evidence_Resubmitted"><bpmn:signalEventDefinition signalRef="Signal_EvidenceResubmitted"/></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="C_End" name="Contribution validation complete"/>
    <bpmn:startEvent id="C_InputStart" name="Input_Requested"><bpmn:signalEventDefinition signalRef="Signal_InputRequested"/></bpmn:startEvent>
    <bpmn:task id="C_PrepareInput" name="Prepare eligible input data and evidence"/>
    <bpmn:intermediateThrowEvent id="C_ThrowInputReady" name="Input_Ready"><bpmn:signalEventDefinition signalRef="Signal_InputReady"/></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="C_InputEnd" name="Input delivered"/>
    <bpmn:boundaryEvent id="C_Governance" name="Governance suspension or rotation" attachedToRef="C_Submit"><bpmn:messageEventDefinition messageRef="Message_GovernanceInterruption"/></bpmn:boundaryEvent>
    <bpmn:task id="C_ApplyGovernance" name="Apply governance suspension or rotation"/>
    <bpmn:endEvent id="C_Suspended" name="Contributor suspended or rotated"/>

    <bpmn:startEvent id="A_Start" name="Aggregator_Authorized"><bpmn:signalEventDefinition signalRef="Signal_AggregatorAuthorized"/></bpmn:startEvent>
    <bpmn:task id="A_PublishAvailability" name="Publish privacy-safe availability record"/>
    <bpmn:task id="A_Match" name="Apply named, versioned exact or semantic Matching Policy"/>
    <bpmn:task id="A_ManualReview" name="Manually review ambiguous matches or keep separate"/>
    <bpmn:task id="A_InviteVerifier" name="Validate product-scoped role exclusion and invite independent Verifier"/>
    <bpmn:intermediateThrowEvent id="A_ThrowInputRequest" name="Input_Requested"><bpmn:signalEventDefinition signalRef="Signal_InputRequested"/></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="A_CatchInputReady" name="Input_Ready"><bpmn:signalEventDefinition signalRef="Signal_InputReady"/></bpmn:intermediateCatchEvent>
    <bpmn:task id="A_SelectInputs" name="Select eligible authorized input versions"/>
    <bpmn:task id="A_Normalize" name="Normalize under named versioned method"/>
    <bpmn:task id="A_HandleQuality" name="Handle outliers, missing data, recency, and minimum independence"/>
    <bpmn:task id="A_Calculate" name="Calculate aggregate confidence and traceability"/>
    <bpmn:task id="A_Revise" name="Revise aggregation inputs or method"/>
    <bpmn:intermediateThrowEvent id="A_ThrowVerification" name="Verification_Request"><bpmn:signalEventDefinition signalRef="Signal_VerificationRequest"/></bpmn:intermediateThrowEvent>
    <bpmn:eventBasedGateway id="A_WaitReview" name="Wait for Verifier review"/>
    <bpmn:intermediateCatchEvent id="A_CatchReview" name="Review_Complete"><bpmn:signalEventDefinition signalRef="Signal_ReviewComplete"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="A_CatchCorrection" name="Correction_Received"><bpmn:signalEventDefinition signalRef="Signal_AggregateCorrection"/></bpmn:intermediateCatchEvent>
    <bpmn:task id="A_PublishAggregate" name="Publish aggregate under access, pricing, and licensing controls"/>
    <bpmn:endEvent id="A_End" name="Aggregation round complete"/>
    <bpmn:boundaryEvent id="A_Governance" name="Governance suspension" attachedToRef="A_Calculate"><bpmn:messageEventDefinition messageRef="Message_GovernanceInterruption"/></bpmn:boundaryEvent>
    <bpmn:task id="A_ApplyGovernance" name="Apply governance suspension"/>
    <bpmn:endEvent id="A_Suspended" name="Aggregator suspended"/>

    <bpmn:startEvent id="V_Start" name="Verifier_Authorized"><bpmn:signalEventDefinition signalRef="Signal_VerifierAuthorized"/></bpmn:startEvent>
    <bpmn:eventBasedGateway id="V_WaitWork" name="Wait for independent verification work"/>
    <bpmn:intermediateCatchEvent id="V_CatchContribution" name="Contribution_Submit"><bpmn:signalEventDefinition signalRef="Signal_ContributionSubmit"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="V_CatchResubmitted" name="Evidence_Resubmitted"><bpmn:signalEventDefinition signalRef="Signal_EvidenceResubmitted"/></bpmn:intermediateCatchEvent>
    <bpmn:task id="V_EvaluateContribution" name="Evaluate evidence against validation, independence, and conflict rules"/>
    <bpmn:exclusiveGateway id="V_ContributionOutcome" name="Contribution outcome"/>
    <bpmn:intermediateThrowEvent id="V_RequestEvidence" name="Request additional evidence: Evidence_Request"><bpmn:signalEventDefinition signalRef="Signal_EvidenceRequest"/></bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="V_Challenge" name="Issue Challenge with reasons"><bpmn:signalEventDefinition signalRef="Signal_Challenge"/></bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="V_Correct" name="Issue Correction preserving prior version and reasons"><bpmn:signalEventDefinition signalRef="Signal_Correction"/></bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="V_Attest" name="Record and send independently accountable Verifier_Attestation"><bpmn:signalEventDefinition signalRef="Signal_VerifierAttestation"/></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="V_CatchVerification" name="Verification_Request"><bpmn:signalEventDefinition signalRef="Signal_VerificationRequest"/></bpmn:intermediateCatchEvent>
    <bpmn:task id="V_ValidateAggregate" name="Validate method, inputs, independence, evidence, and confidence"/>
    <bpmn:exclusiveGateway id="V_AggregateOutcome" name="Aggregate verification outcome"/>
    <bpmn:intermediateThrowEvent id="V_CompleteReview" name="Attest aggregate with limitations: Review_Complete"><bpmn:signalEventDefinition signalRef="Signal_ReviewComplete"/></bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="V_AggregateCorrection" name="Challenge method or input: Correction_Received"><bpmn:signalEventDefinition signalRef="Signal_AggregateCorrection"/></bpmn:intermediateThrowEvent>
    <bpmn:boundaryEvent id="V_Governance" name="Governance suspension" attachedToRef="V_ValidateAggregate"><bpmn:messageEventDefinition messageRef="Message_GovernanceInterruption"/></bpmn:boundaryEvent>
    <bpmn:task id="V_ApplyGovernance" name="Apply governance suspension"/>
    <bpmn:endEvent id="V_Suspended" name="Verifier suspended"/>

    <bpmn:textAnnotation id="Annotation_Eligibility"><bpmn:text>Mutual eligibility exclusion: a Contributor cannot verify its own contribution where independence is required; the same party cannot be Aggregator and Verifier for the same product.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Eligibility" sourceRef="Annotation_Eligibility" targetRef="A_InviteVerifier"/>
    <bpmn:textAnnotation id="Annotation_Semantics"><bpmn:text>Matching and confidence are policy-defined and versioned. Matching, aggregation, and attestation do not guarantee truth, data quality, agreement, reward, or governance outcome. Inputs, prior versions, evidence, challenges, corrections, methods, and reasons remain traceable.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Semantics" sourceRef="Annotation_Semantics" targetRef="A_Calculate"/>

    <bpmn:sequenceFlow id="F_C1" sourceRef="C_Start" targetRef="C_SelectPolicy"/><bpmn:sequenceFlow id="F_C2" sourceRef="C_SelectPolicy" targetRef="C_Submit"/><bpmn:sequenceFlow id="F_C3" sourceRef="C_Submit" targetRef="C_ThrowSubmit"/><bpmn:sequenceFlow id="F_C4" sourceRef="C_ThrowSubmit" targetRef="C_WaitResponse"/><bpmn:sequenceFlow id="F_C5" sourceRef="C_WaitResponse" targetRef="C_CatchEvidence"/><bpmn:sequenceFlow id="F_C6" sourceRef="C_WaitResponse" targetRef="C_CatchChallenge"/><bpmn:sequenceFlow id="F_C7" sourceRef="C_WaitResponse" targetRef="C_CatchCorrection"/><bpmn:sequenceFlow id="F_C8" sourceRef="C_WaitResponse" targetRef="C_CatchAttestation"/><bpmn:sequenceFlow id="F_C9" sourceRef="C_CatchEvidence" targetRef="C_Respond"/><bpmn:sequenceFlow id="F_C10" sourceRef="C_CatchChallenge" targetRef="C_Respond"/><bpmn:sequenceFlow id="F_C11" sourceRef="C_CatchCorrection" targetRef="C_Respond"/><bpmn:sequenceFlow id="F_C12" sourceRef="C_Respond" targetRef="C_ThrowResubmitted"/><bpmn:sequenceFlow id="F_C13" sourceRef="C_ThrowResubmitted" targetRef="C_WaitResponse"/><bpmn:sequenceFlow id="F_C14" sourceRef="C_CatchAttestation" targetRef="C_End"/><bpmn:sequenceFlow id="F_C15" sourceRef="C_InputStart" targetRef="C_PrepareInput"/><bpmn:sequenceFlow id="F_C16" sourceRef="C_PrepareInput" targetRef="C_ThrowInputReady"/><bpmn:sequenceFlow id="F_C17" sourceRef="C_ThrowInputReady" targetRef="C_InputEnd"/><bpmn:sequenceFlow id="F_C18" sourceRef="C_Governance" targetRef="C_ApplyGovernance"/><bpmn:sequenceFlow id="F_C19" sourceRef="C_ApplyGovernance" targetRef="C_Suspended"/>
    <bpmn:sequenceFlow id="F_A1" sourceRef="A_Start" targetRef="A_PublishAvailability"/><bpmn:sequenceFlow id="F_A2" sourceRef="A_PublishAvailability" targetRef="A_Match"/><bpmn:sequenceFlow id="F_A3" sourceRef="A_Match" targetRef="A_ManualReview"/><bpmn:sequenceFlow id="F_A4" sourceRef="A_ManualReview" targetRef="A_InviteVerifier"/><bpmn:sequenceFlow id="F_A5" sourceRef="A_InviteVerifier" targetRef="A_ThrowInputRequest"/><bpmn:sequenceFlow id="F_A6" sourceRef="A_ThrowInputRequest" targetRef="A_CatchInputReady"/><bpmn:sequenceFlow id="F_A7" sourceRef="A_CatchInputReady" targetRef="A_SelectInputs"/><bpmn:sequenceFlow id="F_A8" sourceRef="A_SelectInputs" targetRef="A_Normalize"/><bpmn:sequenceFlow id="F_A9" sourceRef="A_Normalize" targetRef="A_HandleQuality"/><bpmn:sequenceFlow id="F_A10" sourceRef="A_HandleQuality" targetRef="A_Calculate"/><bpmn:sequenceFlow id="F_A11" sourceRef="A_Calculate" targetRef="A_ThrowVerification"/><bpmn:sequenceFlow id="F_A12" sourceRef="A_Revise" targetRef="A_ThrowVerification"/><bpmn:sequenceFlow id="F_A13" sourceRef="A_ThrowVerification" targetRef="A_WaitReview"/><bpmn:sequenceFlow id="F_A14" sourceRef="A_WaitReview" targetRef="A_CatchReview"/><bpmn:sequenceFlow id="F_A15" sourceRef="A_WaitReview" targetRef="A_CatchCorrection"/><bpmn:sequenceFlow id="F_A16" sourceRef="A_CatchReview" targetRef="A_PublishAggregate"/><bpmn:sequenceFlow id="F_A17" sourceRef="A_CatchCorrection" targetRef="A_Revise"/><bpmn:sequenceFlow id="F_A18" sourceRef="A_PublishAggregate" targetRef="A_End"/><bpmn:sequenceFlow id="F_A19" sourceRef="A_Governance" targetRef="A_ApplyGovernance"/><bpmn:sequenceFlow id="F_A20" sourceRef="A_ApplyGovernance" targetRef="A_Suspended"/>
    <bpmn:sequenceFlow id="F_V1" sourceRef="V_Start" targetRef="V_WaitWork"/><bpmn:sequenceFlow id="F_V2" sourceRef="V_WaitWork" targetRef="V_CatchContribution"/><bpmn:sequenceFlow id="F_V3" sourceRef="V_WaitWork" targetRef="V_CatchResubmitted"/><bpmn:sequenceFlow id="F_V4" sourceRef="V_WaitWork" targetRef="V_CatchVerification"/><bpmn:sequenceFlow id="F_V5" sourceRef="V_CatchContribution" targetRef="V_EvaluateContribution"/><bpmn:sequenceFlow id="F_V6" sourceRef="V_CatchResubmitted" targetRef="V_EvaluateContribution"/><bpmn:sequenceFlow id="F_V7" sourceRef="V_EvaluateContribution" targetRef="V_ContributionOutcome"/><bpmn:sequenceFlow id="F_V8" name="additional evidence" sourceRef="V_ContributionOutcome" targetRef="V_RequestEvidence"/><bpmn:sequenceFlow id="F_V9" name="challenge" sourceRef="V_ContributionOutcome" targetRef="V_Challenge"/><bpmn:sequenceFlow id="F_V10" name="correction" sourceRef="V_ContributionOutcome" targetRef="V_Correct"/><bpmn:sequenceFlow id="F_V11" name="validation complete" sourceRef="V_ContributionOutcome" targetRef="V_Attest"/><bpmn:sequenceFlow id="F_V12" sourceRef="V_RequestEvidence" targetRef="V_WaitWork"/><bpmn:sequenceFlow id="F_V13" sourceRef="V_Challenge" targetRef="V_WaitWork"/><bpmn:sequenceFlow id="F_V14" sourceRef="V_Correct" targetRef="V_WaitWork"/><bpmn:sequenceFlow id="F_V15" sourceRef="V_Attest" targetRef="V_WaitWork"/><bpmn:sequenceFlow id="F_V16" sourceRef="V_CatchVerification" targetRef="V_ValidateAggregate"/><bpmn:sequenceFlow id="F_V17" sourceRef="V_ValidateAggregate" targetRef="V_AggregateOutcome"/><bpmn:sequenceFlow id="F_V18" name="review complete" sourceRef="V_AggregateOutcome" targetRef="V_CompleteReview"/><bpmn:sequenceFlow id="F_V19" name="challenge or correction" sourceRef="V_AggregateOutcome" targetRef="V_AggregateCorrection"/><bpmn:sequenceFlow id="F_V20" sourceRef="V_CompleteReview" targetRef="V_WaitWork"/><bpmn:sequenceFlow id="F_V21" sourceRef="V_AggregateCorrection" targetRef="V_WaitWork"/><bpmn:sequenceFlow id="F_V22" sourceRef="V_Governance" targetRef="V_ApplyGovernance"/><bpmn:sequenceFlow id="F_V23" sourceRef="V_ApplyGovernance" targetRef="V_Suspended"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_DataProducerActions"><bpmndi:BPMNPlane id="Plane_DataProducerActions" bpmnElement="Process_Veridica_DataProducerActions">
    <bpmndi:BPMNShape id="Shape_Lane_Contributor" bpmnElement="Lane_Contributor" isHorizontal="true"><dc:Bounds x="80" y="80" width="2580" height="300"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Lane_Aggregator" bpmnElement="Lane_Aggregator" isHorizontal="true"><dc:Bounds x="80" y="380" width="2580" height="330"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Lane_Verifier" bpmnElement="Lane_Verifier" isHorizontal="true"><dc:Bounds x="80" y="710" width="2580" height="340"/></bpmndi:BPMNShape>
