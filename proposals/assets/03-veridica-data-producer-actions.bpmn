<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Veridica_DataProducerActions" targetNamespace="https://unlockit.io/veridica/bpmn">
  <bpmn:process id="Process_Veridica_DataProducerActions" name="03 Veridica Data Producer Actions" isExecutable="false">
    <bpmn:documentation>Compact contribution flow for authorized Contributor, Aggregator, and Verifier roles. The Verifier validates and attests individual contribution versions only and performs no aggregate review or verification. A correction supersedes a version while preserving its linked prior verification as visible evidence marked not current and requiring revalidation. Every corrected version receives a new validation or attestation before returning to matching and aggregation.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_DataProducers">
      <bpmn:lane id="Lane_Contributor" name="Contributor">
        <bpmn:flowNodeRef>C_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Aggregator" name="Aggregator">
        <bpmn:flowNodeRef>A_MatchContributions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_CorrectionNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_RequestCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_AggregateContributions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_PublishContribution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Verifier" name="Verifier">
        <bpmn:flowNodeRef>V_ValidateContribution</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="C_Start" name="Contributor_Authorized">
      <bpmn:outgoing>F_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="C_Submit" name="Submit contribution version">
      <bpmn:incoming>F_1</bpmn:incoming>
      <bpmn:incoming>F_CorrectionLoop</bpmn:incoming>
      <bpmn:outgoing>F_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="V_ValidateContribution" name="Validate and attest contribution version">
      <bpmn:incoming>F_2</bpmn:incoming>
      <bpmn:outgoing>F_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_MatchContributions" name="Match contributions">
      <bpmn:incoming>F_3</bpmn:incoming>
      <bpmn:outgoing>F_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_CorrectionNeeded" name="Correction needed?" gatewayDirection="Diverging">
      <bpmn:incoming>F_4</bpmn:incoming>
      <bpmn:outgoing>F_Correction</bpmn:outgoing>
      <bpmn:outgoing>F_Matched</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_RequestCorrection" name="Request correction">
      <bpmn:incoming>F_Correction</bpmn:incoming>
      <bpmn:outgoing>F_CorrectionLoop</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_AggregateContributions" name="Aggregate matched contributions into consolidated contribution">
      <bpmn:incoming>F_Matched</bpmn:incoming>
      <bpmn:outgoing>F_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_PublishContribution" name="Publish consolidated contribution">
      <bpmn:incoming>F_5</bpmn:incoming>
      <bpmn:outgoing>F_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="A_End" name="Consolidated contribution published">
      <bpmn:incoming>F_6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F_1" sourceRef="C_Start" targetRef="C_Submit" />
    <bpmn:sequenceFlow id="F_2" sourceRef="C_Submit" targetRef="V_ValidateContribution" />
    <bpmn:sequenceFlow id="F_3" sourceRef="V_ValidateContribution" targetRef="A_MatchContributions" />
    <bpmn:sequenceFlow id="F_4" sourceRef="A_MatchContributions" targetRef="G_CorrectionNeeded" />
    <bpmn:sequenceFlow id="F_Correction" name="Yes: mismatch or relevant issue" sourceRef="G_CorrectionNeeded" targetRef="A_RequestCorrection" />
    <bpmn:sequenceFlow id="F_CorrectionLoop" name="Superseding version" sourceRef="A_RequestCorrection" targetRef="C_Submit" />
    <bpmn:sequenceFlow id="F_Matched" name="No: matched" sourceRef="G_CorrectionNeeded" targetRef="A_AggregateContributions" />
    <bpmn:sequenceFlow id="F_5" sourceRef="A_AggregateContributions" targetRef="A_PublishContribution" />
    <bpmn:sequenceFlow id="F_6" sourceRef="A_PublishContribution" targetRef="A_End" />

    <bpmn:textAnnotation id="Note_Contribution">
      <bpmn:text>Submit a versioned contribution with its Contribution ID, Observation Key, standard and policy versions, provenance, evidence, and any corrects or replaces reference.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Validation">
      <bpmn:text>The independently responsible Verifier validates and attests this individual contribution version only. Each superseding corrected version requires a new validation or attestation before matching; the Verifier performs no aggregate review or verification.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Matching">
      <bpmn:text>Apply the named versioned exact or semantic Matching Policy. A mismatch, ambiguity, stale validation, or other relevant issue takes the correction route; only matched, current contributions proceed.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Correction">
      <bpmn:text>The correction supersedes the affected version and links back to it. Preserve the prior version and verification as visible evidence marked “not current / revalidation required”; the loop returns the corrected version through submission and new attestation.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Aggregation">
      <bpmn:text>Normalize matched contribution versions under the named Information Standard and Aggregation Policy, apply the governed calculation and confidence rules, and preserve traceability in the consolidated contribution. No Verifier aggregate task occurs.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Publication">
      <bpmn:text>Publish the consolidated contribution under applicable access, pricing, and licensing controls. No handoff reaches Workflow 05 reward allocation.</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:association id="Assoc_Contribution" sourceRef="C_Submit" targetRef="Note_Contribution" />
    <bpmn:association id="Assoc_Validation" sourceRef="V_ValidateContribution" targetRef="Note_Validation" />
    <bpmn:association id="Assoc_Matching" sourceRef="A_MatchContributions" targetRef="Note_Matching" />
    <bpmn:association id="Assoc_Correction" sourceRef="A_RequestCorrection" targetRef="Note_Correction" />
    <bpmn:association id="Assoc_Aggregation" sourceRef="A_AggregateContributions" targetRef="Note_Aggregation" />
    <bpmn:association id="Assoc_Publication" sourceRef="A_PublishContribution" targetRef="Note_Publication" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_DataProducerActions">
    <bpmndi:BPMNPlane id="Plane_DataProducerActions" bpmnElement="Process_Veridica_DataProducerActions">
      <bpmndi:BPMNShape id="Shape_Lane_Contributor" bpmnElement="Lane_Contributor" isHorizontal="true"><dc:Bounds x="80" y="80" width="1940" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Aggregator" bpmnElement="Lane_Aggregator" isHorizontal="true"><dc:Bounds x="80" y="320" width="1940" height="300" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Verifier" bpmnElement="Lane_Verifier" isHorizontal="true"><dc:Bounds x="80" y="620" width="1940" height="240" /></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_C_Start" bpmnElement="C_Start"><dc:Bounds x="130" y="165" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C_Submit" bpmnElement="C_Submit"><dc:Bounds x="215" y="140" width="180" height="86" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_V_ValidateContribution" bpmnElement="V_ValidateContribution"><dc:Bounds x="465" y="665" width="210" height="86" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_MatchContributions" bpmnElement="A_MatchContributions"><dc:Bounds x="755" y="370" width="180" height="86" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_CorrectionNeeded" bpmnElement="G_CorrectionNeeded" isMarkerVisible="true"><dc:Bounds x="1010" y="388" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_RequestCorrection" bpmnElement="A_RequestCorrection"><dc:Bounds x="955" y="500" width="160" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_AggregateContributions" bpmnElement="A_AggregateContributions"><dc:Bounds x="1200" y="360" width="270" height="106" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_PublishContribution" bpmnElement="A_PublishContribution"><dc:Bounds x="1570" y="370" width="210" height="86" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_End" bpmnElement="A_End"><dc:Bounds x="1870" y="395" width="36" height="36" /></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Note_Contribution" bpmnElement="Note_Contribution"><dc:Bounds x="195" y="245" width="250" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Note_Validation" bpmnElement="Note_Validation"><dc:Bounds x="425" y="770" width="290" height="75" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Note_Matching" bpmnElement="Note_Matching"><dc:Bounds x="710" y="480" width="220" height="105" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Note_Correction" bpmnElement="Note_Correction"><dc:Bounds x="950" y="635" width="300" height="95" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Note_Aggregation" bpmnElement="Note_Aggregation"><dc:Bounds x="1200" y="490" width="285" height="95" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Note_Publication" bpmnElement="Note_Publication"><dc:Bounds x="1555" y="490" width="245" height="80" /></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_F_1" bpmnElement="F_1"><di:waypoint x="166" y="183" /><di:waypoint x="215" y="183" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_2" bpmnElement="F_2"><di:waypoint x="395" y="183" /><di:waypoint x="430" y="183" /><di:waypoint x="430" y="708" /><di:waypoint x="465" y="708" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_3" bpmnElement="F_3"><di:waypoint x="675" y="708" /><di:waypoint x="715" y="708" /><di:waypoint x="715" y="413" /><di:waypoint x="755" y="413" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_4" bpmnElement="F_4"><di:waypoint x="935" y="413" /><di:waypoint x="1010" y="413" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_Correction" bpmnElement="F_Correction"><di:waypoint x="1035" y="438" /><di:waypoint x="1035" y="500" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_CorrectionLoop" bpmnElement="F_CorrectionLoop"><di:waypoint x="955" y="538" /><di:waypoint x="900" y="538" /><di:waypoint x="900" y="330" /><di:waypoint x="460" y="330" /><di:waypoint x="460" y="115" /><di:waypoint x="305" y="115" /><di:waypoint x="305" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_Matched" bpmnElement="F_Matched"><di:waypoint x="1060" y="413" /><di:waypoint x="1200" y="413" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_5" bpmnElement="F_5"><di:waypoint x="1470" y="413" /><di:waypoint x="1570" y="413" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_6" bpmnElement="F_6"><di:waypoint x="1780" y="413" /><di:waypoint x="1870" y="413" /></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Assoc_Contribution" bpmnElement="Assoc_Contribution"><di:waypoint x="305" y="226" /><di:waypoint x="305" y="245" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Assoc_Validation" bpmnElement="Assoc_Validation"><di:waypoint x="570" y="751" /><di:waypoint x="570" y="770" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Assoc_Matching" bpmnElement="Assoc_Matching"><di:waypoint x="845" y="456" /><di:waypoint x="845" y="480" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Assoc_Correction" bpmnElement="Assoc_Correction"><di:waypoint x="1035" y="576" /><di:waypoint x="1035" y="635" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Assoc_Aggregation" bpmnElement="Assoc_Aggregation"><di:waypoint x="1335" y="466" /><di:waypoint x="1335" y="490" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Assoc_Publication" bpmnElement="Assoc_Publication"><di:waypoint x="1675" y="456" /><di:waypoint x="1675" y="490" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
