      <bpmndi:BPMNEdge id="Edge_MF_ConsolidatedContribution" bpmnElement="MF_ConsolidatedContribution">
        <di:waypoint x="970" y="718" />
        <di:waypoint x="970" y="760" />
        <di:waypoint x="10" y="760" />
