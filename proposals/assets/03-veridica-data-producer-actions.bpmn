      <bpmndi:BPMNShape id="Shape_Note_Correction" bpmnElement="Note_Correction">
        <dc:Bounds x="550" y="160" width="445" height="57" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
