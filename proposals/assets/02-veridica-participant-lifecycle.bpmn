<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_veridica_participant_lifecycle" targetNamespace="https://unlockit.io/veridica/bpmn" exporter="Veridica deterministic renderer" exporterVersion="4.0">
  <bpmn:message id="Message_ChassisDelivery" name="Chassis lifecycle delivery" />
  <bpmn:collaboration id="Collaboration_02">
    <bpmn:participant id="Participant_VeridicaPlatform" name="Veridica Platform (chassis)" processRef="Process_VeridicaPlatform" />
    <bpmn:participant id="Participant_Process_ContributorParty" name="Contributor Party (multiplicity 1..999)" processRef="Process_ContributorParty">
      <bpmn:participantMultiplicity minimum="1" maximum="999" />
    </bpmn:participant>
    <bpmn:participant id="Participant_Process_AggregatorParty" name="Aggregator Party (multiplicity 1..999)" processRef="Process_AggregatorParty">
      <bpmn:participantMultiplicity minimum="1" maximum="999" />
    </bpmn:participant>
    <bpmn:participant id="Participant_Process_VerifierParty" name="Verifier Party (multiplicity 1..999)" processRef="Process_VerifierParty">
      <bpmn:participantMultiplicity minimum="1" maximum="999" />
    </bpmn:participant>
    <bpmn:participant id="Participant_Process_ConsumerParty" name="Consumer Party (multiplicity 1..999)" processRef="Process_ConsumerParty">
      <bpmn:participantMultiplicity minimum="1" maximum="999" />
    </bpmn:participant>
    <bpmn:messageFlow id="MF_ChassisDelivery_Contributor" name="Chassis lifecycle delivery" sourceRef="VP_NotifySent" targetRef="CP_ChassisDeliveryReceived" />
    <bpmn:messageFlow id="MF_ChassisDelivery_Aggregator" name="Chassis lifecycle delivery" sourceRef="VP_NotifySent" targetRef="AG_ChassisDeliveryReceived" />
    <bpmn:messageFlow id="MF_ChassisDelivery_Verifier" name="Chassis lifecycle delivery" sourceRef="VP_NotifySent" targetRef="VR_ChassisDeliveryReceived" />
    <bpmn:messageFlow id="MF_ChassisDelivery_Consumer" name="Chassis lifecycle delivery" sourceRef="VP_NotifySent" targetRef="CS_ChassisDeliveryReceived" />
  </bpmn:collaboration>
  <bpmn:process id="Process_VeridicaPlatform" isExecutable="false">
    <bpmn:laneSet id="Lanes_VeridicaPlatform">
      <bpmn:lane id="Lane_VeridicaPlatform" name="Veridica Platform (chassis)">
        <bpmn:flowNodeRef>VP_DecisionReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DataObject_ActiveMechanism</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Execute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_GovernanceInterruption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_ApplyInterruption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_NotifyInterruption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_NotifyInterruptionSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_AuditInterruption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Decommissioned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_NotifySent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="VP_DecisionReceived" name="Access request received">
      <bpmn:outgoing>VP1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:dataObject id="DataObject_ActiveMechanism" name="Active Governance Mechanism">
      <bpmn:extensionElements>
        <bpmn:documentation xml:space="preserve">Specifies the active mechanism (CAP): the ballot, resolution and verification rules that govern participant admission. Issued and version-pinned by governance (01B). The Veridica Platform consults this document to admit contributors, aggregators, verifiers or consumers.</bpmn:documentation>
      </bpmn:extensionElements>
    </bpmn:dataObject>
    <bpmn:task id="VP_Validate" name="Validate request against active governance mechanism">
      <bpmn:incoming>VP1</bpmn:incoming>
      <bpmn:outgoing>VP2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:association id="Assoc_MechanismToValidate" associationDirection="One" sourceRef="DataObject_ActiveMechanism" targetRef="VP_Validate" />
    <bpmn:task id="VP_Execute" name="Execute chassis action: admit, assign role, suspend, remove, or rotate credential">
      <bpmn:incoming>VP2</bpmn:incoming>
      <bpmn:outgoing>VP3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="VP_GovernanceInterruption" name="Governance-mandated interruption" attachedToRef="VP_Execute">
      <bpmn:outgoing>VP_BI1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ChassisDelivery" />
    </bpmn:boundaryEvent>
    <bpmn:task id="VP_ApplyInterruption" name="Apply governance-mandated suspension, rotation, or decommission">
      <bpmn:incoming>VP_BI1</bpmn:incoming>
      <bpmn:outgoing>VP_BI2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="VP_NotifyInterruption" name="Notify role party of governance-mandated interruption">
      <bpmn:incoming>VP_BI2</bpmn:incoming>
      <bpmn:outgoing>VP_BI3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="VP_NotifyInterruptionSent" name="Governance interruption delivery sent">
      <bpmn:incoming>VP_BI3</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_ChassisDelivery" />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="VP_AuditInterruption" name="Audit governance-mandated interruption">
      <bpmn:incoming>VP_BI4</bpmn:incoming>
      <bpmn:outgoing>VP_BI5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="VP_Decommissioned" name="Decommissioned by governance">
      <bpmn:incoming>VP_BI5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="VP_Notify" name="Notify role party of chassis action outcome">
      <bpmn:incoming>VP3</bpmn:incoming>
      <bpmn:outgoing>VP4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="VP_NotifySent" name="Chassis delivery sent">
      <bpmn:incoming>VP4</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_ChassisDelivery" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="VP_End" name="Chassis action complete">
      <bpmn:incoming>VP5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="VP1" sourceRef="VP_DecisionReceived" targetRef="VP_Validate" />
    <bpmn:sequenceFlow id="VP2" sourceRef="VP_Validate" targetRef="VP_Execute" />
    <bpmn:sequenceFlow id="VP3" sourceRef="VP_Execute" targetRef="VP_Notify" />
    <bpmn:sequenceFlow id="VP4" sourceRef="VP_Notify" targetRef="VP_NotifySent" />
    <bpmn:sequenceFlow id="VP5" sourceRef="VP_NotifySent" targetRef="VP_End" />
    <bpmn:sequenceFlow id="VP_BI1" sourceRef="VP_GovernanceInterruption" targetRef="VP_ApplyInterruption" />
    <bpmn:sequenceFlow id="VP_BI2" sourceRef="VP_ApplyInterruption" targetRef="VP_NotifyInterruption" />
    <bpmn:sequenceFlow id="VP_BI3" sourceRef="VP_NotifyInterruption" targetRef="VP_NotifyInterruptionSent" />
    <bpmn:sequenceFlow id="VP_BI4" sourceRef="VP_NotifyInterruptionSent" targetRef="VP_AuditInterruption" />
    <bpmn:sequenceFlow id="VP_BI5" sourceRef="VP_AuditInterruption" targetRef="VP_Decommissioned" />
  </bpmn:process>
  <bpmn:process id="Process_ContributorParty" isExecutable="false">
    <bpmn:laneSet id="Lanes_ContributorParty">
      <bpmn:lane id="Lane_ContributorParty" name="Contributor Party">
        <bpmn:flowNodeRef>CP_ChassisDeliveryReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_ApplyDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CP_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="CP_ChassisDeliveryReceived" name="Chassis lifecycle delivery received">
      <bpmn:outgoing>CP1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ChassisDelivery" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="CP_ApplyDelivery" name="Apply chassis action as Contributor per active mechanism">
      <bpmn:incoming>CP1</bpmn:incoming>
      <bpmn:outgoing>CP2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="CP_End" name="Contributor lifecycle stage complete">
      <bpmn:incoming>CP2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CP1" sourceRef="CP_ChassisDeliveryReceived" targetRef="CP_ApplyDelivery" />
    <bpmn:sequenceFlow id="CP2" sourceRef="CP_ApplyDelivery" targetRef="CP_End" />
  </bpmn:process>
  <bpmn:process id="Process_AggregatorParty" isExecutable="false">
    <bpmn:laneSet id="Lanes_AggregatorParty">
      <bpmn:lane id="Lane_AggregatorParty" name="Aggregator Party">
        <bpmn:flowNodeRef>AG_ChassisDeliveryReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AG_ApplyDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AG_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="AG_ChassisDeliveryReceived" name="Chassis lifecycle delivery received">
      <bpmn:outgoing>AG1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ChassisDelivery" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="AG_ApplyDelivery" name="Apply chassis action as Aggregator per active mechanism">
      <bpmn:incoming>AG1</bpmn:incoming>
      <bpmn:outgoing>AG2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="AG_End" name="Aggregator lifecycle stage complete">
      <bpmn:incoming>AG2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="AG1" sourceRef="AG_ChassisDeliveryReceived" targetRef="AG_ApplyDelivery" />
    <bpmn:sequenceFlow id="AG2" sourceRef="AG_ApplyDelivery" targetRef="AG_End" />
  </bpmn:process>
  <bpmn:process id="Process_VerifierParty" isExecutable="false">
    <bpmn:laneSet id="Lanes_VerifierParty">
      <bpmn:lane id="Lane_VerifierParty" name="Verifier Party">
        <bpmn:flowNodeRef>VR_ChassisDeliveryReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_ApplyDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="VR_ChassisDeliveryReceived" name="Chassis lifecycle delivery received">
      <bpmn:outgoing>VR1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ChassisDelivery" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="VR_ApplyDelivery" name="Apply chassis action as Verifier per active mechanism">
      <bpmn:incoming>VR1</bpmn:incoming>
      <bpmn:outgoing>VR2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="VR_End" name="Verifier lifecycle stage complete">
      <bpmn:incoming>VR2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="VR1" sourceRef="VR_ChassisDeliveryReceived" targetRef="VR_ApplyDelivery" />
    <bpmn:sequenceFlow id="VR2" sourceRef="VR_ApplyDelivery" targetRef="VR_End" />
  </bpmn:process>
  <bpmn:process id="Process_ConsumerParty" isExecutable="false">
    <bpmn:laneSet id="Lanes_ConsumerParty">
      <bpmn:lane id="Lane_ConsumerParty" name="Consumer Party">
        <bpmn:flowNodeRef>CS_ChassisDeliveryReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CS_ApplyDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CS_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="CS_ChassisDeliveryReceived" name="Chassis lifecycle delivery received">
      <bpmn:outgoing>CS1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ChassisDelivery" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="CS_ApplyDelivery" name="Apply chassis action as Consumer per active mechanism">
      <bpmn:incoming>CS1</bpmn:incoming>
      <bpmn:outgoing>CS2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="CS_End" name="Consumer lifecycle stage complete">
      <bpmn:incoming>CS2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CS1" sourceRef="CS_ChassisDeliveryReceived" targetRef="CS_ApplyDelivery" />
    <bpmn:sequenceFlow id="CS2" sourceRef="CS_ApplyDelivery" targetRef="CS_End" />
  </bpmn:process>
