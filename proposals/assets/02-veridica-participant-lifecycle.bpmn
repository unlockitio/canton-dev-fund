        <di:waypoint x="1140" y="358" />
        <di:waypoint x="1180" y="358" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="DI_Participant_Process_ContributorParty" bpmnElement="Participant_Process_ContributorParty" isHorizontal="true">
        <dc:Bounds x="20" y="700" width="1540" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CP_RoleBindingReceived" bpmnElement="CP_RoleBindingReceived">
        <dc:Bounds x="200" y="820" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="160" y="856" width="116" height="27" />
        </bpmndi:BPMNLabel>
