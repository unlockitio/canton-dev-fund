<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Veridica_Access_Lifecycle" targetNamespace="https://unlockit.io/veridica/bpmn" exporter="Veridica deterministic renderer" exporterVersion="4.0">
  <bpmn:message id="Message_AdmissionRequest" name="Admission request" />
  <bpmn:message id="Message_SelfRequest" name="Prospective participant self-request" />
  <bpmn:message id="Message_CapabilityRequest" name="Additional role or credential request" />
  <bpmn:message id="Message_RevocationRequest" name="Governed revocation request" />
  <bpmn:message id="Message_Renunciation" name="Named role renunciation" />
  <bpmn:collaboration id="Collaboration_02_Access">
    <bpmn:participant id="Participant_Governor" name="Governor or Consortium Member" processRef="Process_Governor" />
    <bpmn:participant id="Participant_Prospective" name="Prospective Participant" processRef="Process_Prospective">
      <bpmn:participantMultiplicity minimum="1" maximum="999" />
    </bpmn:participant>
    <bpmn:participant id="Participant_Active" name="Veridica Participant" processRef="Process_Active">
      <bpmn:participantMultiplicity minimum="1" maximum="999" />
    </bpmn:participant>
    <bpmn:participant id="Participant_Operator" name="Veridica Operator" processRef="Process_Operator" />
    <bpmn:messageFlow id="MF_Admission" name="Access Request" sourceRef="End_GovAdmission" targetRef="Start_Admission" />
    <bpmn:messageFlow id="MF_Self" name="Access Request" sourceRef="End_SelfRequest" targetRef="Start_SelfRequest" />
    <bpmn:messageFlow id="MF_Capability" name="Access Request" sourceRef="End_CapabilityRequest" targetRef="Start_CapabilityRequest" />
    <bpmn:messageFlow id="MF_Revocation" name="Revocation request sent" sourceRef="End_GovRevocation" targetRef="Start_Revocation" />
    <bpmn:messageFlow id="MF_Renunciation" name="Named role renunciation" sourceRef="End_Renunciation" targetRef="Start_Renunciation" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Governor" isExecutable="false">
    <bpmn:startEvent id="Start_Sponsor" name="Sponsor, offer, or request admission">
      <bpmn:outgoing>G1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_NameAdmission" name="Name candidate and requested role capabilities">
      <bpmn:incoming>G1</bpmn:incoming>
      <bpmn:outgoing>G2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_GovAdmission" name="Admission request sent">
      <bpmn:incoming>G2</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_AdmissionRequest" />
    </bpmn:endEvent>
    <bpmn:task id="Task_NameRevocation" name="Name access or capabilities for revocation">
      <bpmn:incoming>G3</bpmn:incoming>
      <bpmn:outgoing>G4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_GovRevocation">
      <bpmn:incoming>G4</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_RevocationRequest" />
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_GovRevocation" name="Governed revocation requested">
      <bpmn:outgoing>G3</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="ConditionalEventDefinition_0hsvlgy">
        <bpmn:condition xsi:type="bpmn:tFormalExpression" />
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="G1" sourceRef="Start_Sponsor" targetRef="Task_NameAdmission" />
    <bpmn:sequenceFlow id="G2" sourceRef="Task_NameAdmission" targetRef="End_GovAdmission" />
    <bpmn:sequenceFlow id="G3" sourceRef="Start_GovRevocation" targetRef="Task_NameRevocation" />
    <bpmn:sequenceFlow id="G4" sourceRef="Task_NameRevocation" targetRef="End_GovRevocation" />
  </bpmn:process>
  <bpmn:process id="Process_Prospective" isExecutable="false">
    <bpmn:startEvent id="Start_Self" name="Request own admission">
      <bpmn:outgoing>P1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_PrepareSelf" name="Submit identity, evidence, and requested capabilities">
      <bpmn:incoming>P1</bpmn:incoming>
      <bpmn:outgoing>P2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_SelfRequest" name="Self-request sent">
      <bpmn:incoming>P2</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_SelfRequest" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P1" sourceRef="Start_Self" targetRef="Task_PrepareSelf" />
    <bpmn:sequenceFlow id="P2" sourceRef="Task_PrepareSelf" targetRef="End_SelfRequest" />
  </bpmn:process>
  <bpmn:process id="Process_Active" isExecutable="false">
    <bpmn:startEvent id="Start_Capability" name="Request more role or credential capability">
      <bpmn:outgoing>A1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_NameCapability" name="Name requested role capability and evidence">
      <bpmn:incoming>A1</bpmn:incoming>
      <bpmn:outgoing>A2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_CapabilityRequest" name="Capability request sent">
      <bpmn:incoming>A2</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_CapabilityRequest" />
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_Renounce" name="Unilaterally renounce held role">
      <bpmn:outgoing>A3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_NameRenunciation" name="Name held role capability to renounce">
      <bpmn:incoming>A3</bpmn:incoming>
      <bpmn:outgoing>A4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Renunciation" name="Named renunciation sent">
      <bpmn:incoming>A4</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_Renunciation" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="A1" sourceRef="Start_Capability" targetRef="Task_NameCapability" />
    <bpmn:sequenceFlow id="A2" sourceRef="Task_NameCapability" targetRef="End_CapabilityRequest" />
    <bpmn:sequenceFlow id="A3" sourceRef="Start_Renounce" targetRef="Task_NameRenunciation" />
    <bpmn:sequenceFlow id="A4" sourceRef="Task_NameRenunciation" targetRef="End_Renunciation" />
  </bpmn:process>
  <bpmn:process id="Process_Operator" isExecutable="false">
    <bpmn:dataObjectReference id="Ref_ActiveGovernance" name="Active Governance Mechanism&#10;(version-pinned document from 01B)" dataObjectRef="Data_ActiveGovernance" />
    <bpmn:dataObject id="Data_ActiveGovernance" name="Active Governance Mechanism (version-pinned document from 01B)" />
    <bpmn:dataObjectReference id="Ref_AccessRequest" name="Access Request" dataObjectRef="Data_AccessRequest" />
    <bpmn:dataObject id="Data_AccessRequest" name="Access Request" />
    <bpmn:dataObjectReference id="Ref_AccessRecord" name="Participant Access Record" dataObjectRef="Data_AccessRecord" />
    <bpmn:dataObject id="Data_AccessRecord" name="Participant Access Record" />
    <bpmn:dataObjectReference id="Ref_Bindings" name="Role Capability Bindings" dataObjectRef="Data_Bindings" />
    <bpmn:dataObject id="Data_Bindings" name="Role Capability Bindings" />
    <bpmn:dataObjectReference id="Ref_Audit" name="Lifecycle Audit Record" dataObjectRef="Data_Audit" />
    <bpmn:dataObject id="Data_Audit" name="Lifecycle Audit Record" />
    <bpmn:startEvent id="Start_Admission" name="Sponsored admission request received">
      <bpmn:outgoing>O1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_AdmissionRequest" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_SelfRequest" name="Self-request received">
      <bpmn:outgoing>O2</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_SelfRequest" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_CapabilityRequest" name="Additional capability request received">
      <bpmn:outgoing>O3</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CapabilityRequest" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_RequestMerge">
      <bpmn:incoming>O1</bpmn:incoming>
      <bpmn:incoming>O2</bpmn:incoming>
      <bpmn:incoming>O3</bpmn:incoming>
      <bpmn:outgoing>O4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ValidateRequest" name="Validate request and governed eligibility policy">
      <bpmn:incoming>O4</bpmn:incoming>
      <bpmn:outgoing>O5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:callActivity id="Call_GovernedAdmission" name="Obtain governed outcome from 01B" calledElement="Process_01B_Governance">
      <bpmn:incoming>O5</bpmn:incoming>
      <bpmn:outgoing>O6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_AdmissionOutcome" name="Admission or capability approved?">
      <bpmn:incoming>O6</bpmn:incoming>
      <bpmn:outgoing>O7</bpmn:outgoing>
      <bpmn:outgoing>O8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RecordBinding" name="Record and activate accepted role capability with scoped credentials">
      <bpmn:documentation>Parallel multi-instance over the independent accepted role capabilities in the governed approved outcome, such as Contributor or Consumer.</bpmn:documentation>
      <bpmn:incoming>O7</bpmn:incoming>
      <bpmn:outgoing>O9</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:task>
    <bpmn:task id="Task_AuditAdmission" name="Update participant access and lifecycle audit records">
      <bpmn:incoming>O8</bpmn:incoming>
      <bpmn:incoming>O9</bpmn:incoming>
      <bpmn:outgoing>O10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_AdmissionHandled" name="Admission or capability case recorded">
      <bpmn:incoming>O10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_Revocation" name="Governed revocation request received">
      <bpmn:outgoing>O11</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_RevocationRequest" />
    </bpmn:startEvent>
    <bpmn:callActivity id="Call_GovernedRevocation" name="Obtain governed outcome from 01B" calledElement="Process_01B_Governance">
      <bpmn:incoming>O11</bpmn:incoming>
      <bpmn:outgoing>O12</bpmn:outgoing>
      <bpmn:property id="Property_1p9ey3w" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1jaspdv">
        <bpmn:sourceRef>Ref_ActiveGovernance</bpmn:sourceRef>
        <bpmn:targetRef>Property_1p9ey3w</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_RevocationApproved" name="Named removal approved?">
      <bpmn:incoming>O12</bpmn:incoming>
      <bpmn:outgoing>O13</bpmn:outgoing>
      <bpmn:outgoing>O14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RecordRevocation" name="Preserve unrelated capabilities and record audit">
      <bpmn:incoming>O14</bpmn:incoming>
      <bpmn:incoming>O15</bpmn:incoming>
      <bpmn:outgoing>O16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Revocation" name="Governed revocation case recorded">
      <bpmn:incoming>O16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_Renunciation" name="Named renunciation received">
      <bpmn:outgoing>O17</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Renunciation" />
    </bpmn:startEvent>
    <bpmn:task id="Task_ProcessRenunciation" name="Process named renunciation">
      <bpmn:incoming>O17</bpmn:incoming>
      <bpmn:outgoing>O20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:textAnnotation id="Annotation_RenunciationObligations">
      <bpmn:text>Verify participant control; remove only the named capability and scoped credentials; preserve unrelated capabilities; record audit evidence.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:endEvent id="End_RenunciationHandled" name="Renunciation recorded without governance">
      <bpmn:incoming>O20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="Ref_GovernedOutcome" name="Governed Outcome" dataObjectRef="Data_GovernedOutcome" />
    <bpmn:dataObject id="Data_GovernedOutcome" name="Governed Outcome" />
    <bpmn:sequenceFlow id="O1" sourceRef="Start_Admission" targetRef="Gateway_RequestMerge" />
    <bpmn:sequenceFlow id="O2" sourceRef="Start_SelfRequest" targetRef="Gateway_RequestMerge" />
    <bpmn:sequenceFlow id="O3" sourceRef="Start_CapabilityRequest" targetRef="Gateway_RequestMerge" />
    <bpmn:sequenceFlow id="O4" sourceRef="Gateway_RequestMerge" targetRef="Task_ValidateRequest" />
    <bpmn:sequenceFlow id="O5" sourceRef="Task_ValidateRequest" targetRef="Call_GovernedAdmission" />
    <bpmn:sequenceFlow id="O6" sourceRef="Call_GovernedAdmission" targetRef="Gateway_AdmissionOutcome" />
    <bpmn:sequenceFlow id="O7" name="Approved" sourceRef="Gateway_AdmissionOutcome" targetRef="Task_RecordBinding" />
    <bpmn:sequenceFlow id="O8" name="Rejected or expired" sourceRef="Gateway_AdmissionOutcome" targetRef="Task_AuditAdmission" />
    <bpmn:sequenceFlow id="O9" sourceRef="Task_RecordBinding" targetRef="Task_AuditAdmission" />
    <bpmn:sequenceFlow id="O10" sourceRef="Task_AuditAdmission" targetRef="End_AdmissionHandled" />
    <bpmn:sequenceFlow id="O11" sourceRef="Start_Revocation" targetRef="Call_GovernedRevocation" />
    <bpmn:sequenceFlow id="O12" sourceRef="Call_GovernedRevocation" targetRef="Gateway_RevocationApproved" />
    <bpmn:sequenceFlow id="O13" name="Approved" sourceRef="Gateway_RevocationApproved" targetRef="Task_RemoveGoverned" />
    <bpmn:sequenceFlow id="O14" name="Not approved" sourceRef="Gateway_RevocationApproved" targetRef="Task_RecordRevocation" />
    <bpmn:sequenceFlow id="O15" sourceRef="Task_RemoveGoverned" targetRef="Task_RecordRevocation" />
    <bpmn:sequenceFlow id="O16" sourceRef="Task_RecordRevocation" targetRef="End_Revocation" />
    <bpmn:sequenceFlow id="O17" sourceRef="Start_Renunciation" targetRef="Task_ProcessRenunciation" />
    <bpmn:sequenceFlow id="O20" sourceRef="Task_ProcessRenunciation" targetRef="End_RenunciationHandled" />
    <bpmn:task id="Task_RemoveGoverned" name="Remove only named access or capabilities in outcome">
      <bpmn:incoming>O13</bpmn:incoming>
      <bpmn:outgoing>O15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:association id="Assoc_GovernanceAdmission" associationDirection="One" sourceRef="Ref_ActiveGovernance" targetRef="Call_GovernedAdmission" />
    <bpmn:association id="Assoc_Request" associationDirection="One" sourceRef="Ref_AccessRequest" targetRef="Task_ValidateRequest" />
    <bpmn:association id="Assoc_AccessRecord" associationDirection="One" sourceRef="Task_AuditAdmission" targetRef="Ref_AccessRecord" />
    <bpmn:association id="Assoc_Bindings" associationDirection="One" sourceRef="Task_RecordBinding" targetRef="Ref_Bindings" />
    <bpmn:association id="Assoc_RenunciationObligations" sourceRef="Task_ProcessRenunciation" targetRef="Annotation_RenunciationObligations" />
    <bpmn:association id="Assoc_Audit" associationDirection="One" sourceRef="Task_ProcessRenunciation" targetRef="Ref_Audit" />
    <bpmn:association id="Assoc_Outcome" associationDirection="One" sourceRef="Call_GovernedAdmission" targetRef="Ref_GovernedOutcome" />
  </bpmn:process>
