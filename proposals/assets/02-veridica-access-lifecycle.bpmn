<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Veridica_Access_Lifecycle" targetNamespace="https://unlockit.io/veridica/bpmn" exporter="Veridica deterministic renderer" exporterVersion="4.0">
  <bpmn:message id="Message_AdmissionRequest" name="Admission request" />
  <bpmn:message id="Message_SelfRequest" name="Prospective participant self-request" />
  <bpmn:message id="Message_CapabilityRequest" name="Additional role or credential request" />
  <bpmn:message id="Message_RevocationRequest" name="Governed revocation request" />
  <bpmn:message id="Message_Renunciation" name="Named role renunciation" />
  <bpmn:message id="Message_Offer" name="Role-specific admission or capability offer" />
  <bpmn:message id="Message_ProspectResponse" name="Prospective participant response" />
  <bpmn:message id="Message_ParticipantResponse" name="Veridica participant response" />
  <bpmn:collaboration id="Collaboration_02_Access">
    <bpmn:participant id="Participant_Governor" name="Governor or Consortium Member" processRef="Process_Governor" />
    <bpmn:participant id="Participant_Prospective" name="Prospective Participant" processRef="Process_Prospective"><bpmn:participantMultiplicity minimum="1" maximum="999" /></bpmn:participant>
    <bpmn:participant id="Participant_Active" name="Veridica Participant" processRef="Process_Active"><bpmn:participantMultiplicity minimum="1" maximum="999" /></bpmn:participant>
    <bpmn:participant id="Participant_Operator" name="Veridica Operator" processRef="Process_Operator" />
    <bpmn:messageFlow id="MF_Admission" name="Access Request" sourceRef="End_GovAdmission" targetRef="Start_Admission" />
    <bpmn:messageFlow id="MF_Self" name="Access Request" sourceRef="End_SelfRequest" targetRef="Start_SelfRequest" />
    <bpmn:messageFlow id="MF_Capability" name="Access Request" sourceRef="End_CapabilityRequest" targetRef="Start_CapabilityRequest" />
    <bpmn:messageFlow id="MF_Revocation" name="Access Request" sourceRef="End_GovRevocation" targetRef="Start_Revocation" />
    <bpmn:messageFlow id="MF_Renunciation" name="Access Request" sourceRef="End_Renunciation" targetRef="Start_Renunciation" />
    <bpmn:messageFlow id="MF_OfferProspect" name="Admission or Capability Offer" sourceRef="Throw_OfferProspect" targetRef="Start_ProspectOffer" />
    <bpmn:messageFlow id="MF_OfferActive" name="Admission or Capability Offer" sourceRef="Throw_OfferActive" targetRef="Start_ActiveOffer" />
    <bpmn:messageFlow id="MF_ProspectResponse" name="Participant Response" sourceRef="End_ProspectResponse" targetRef="Catch_Response" />
    <bpmn:messageFlow id="MF_ActiveResponse" name="Participant Response" sourceRef="End_ActiveResponse" targetRef="Catch_Response" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Governor" isExecutable="false">
    <bpmn:startEvent id="Start_Sponsor" name="Sponsor, offer, or request admission"><bpmn:outgoing>G1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_NameAdmission" name="Name candidate and requested role capabilities"><bpmn:incoming>G1</bpmn:incoming><bpmn:outgoing>G2</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_GovAdmission" name="Admission request sent"><bpmn:incoming>G2</bpmn:incoming><bpmn:messageEventDefinition messageRef="Message_AdmissionRequest" /></bpmn:endEvent>
    <bpmn:startEvent id="Start_GovRevocation" name="Governed revocation requested"><bpmn:outgoing>G3</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_NameRevocation" name="Name access or capabilities for revocation"><bpmn:incoming>G3</bpmn:incoming><bpmn:outgoing>G4</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_GovRevocation" name="Revocation request sent"><bpmn:incoming>G4</bpmn:incoming><bpmn:messageEventDefinition messageRef="Message_RevocationRequest" /></bpmn:endEvent>
    <bpmn:sequenceFlow id="G1" sourceRef="Start_Sponsor" targetRef="Task_NameAdmission" /><bpmn:sequenceFlow id="G2" sourceRef="Task_NameAdmission" targetRef="End_GovAdmission" />
    <bpmn:sequenceFlow id="G3" sourceRef="Start_GovRevocation" targetRef="Task_NameRevocation" /><bpmn:sequenceFlow id="G4" sourceRef="Task_NameRevocation" targetRef="End_GovRevocation" />
  </bpmn:process>

  <bpmn:process id="Process_Prospective" isExecutable="false">
    <bpmn:startEvent id="Start_Self" name="Request own admission"><bpmn:outgoing>P1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_PrepareSelf" name="Submit identity, evidence, and requested capabilities"><bpmn:incoming>P1</bpmn:incoming><bpmn:outgoing>P2</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_SelfRequest" name="Self-request sent"><bpmn:incoming>P2</bpmn:incoming><bpmn:messageEventDefinition messageRef="Message_SelfRequest" /></bpmn:endEvent>
    <bpmn:startEvent id="Start_ProspectOffer" name="Role-specific offer received"><bpmn:outgoing>P3</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_Offer" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_ProspectDecision" name="Accept this role capability?"><bpmn:incoming>P3</bpmn:incoming><bpmn:outgoing>P4</bpmn:outgoing><bpmn:outgoing>P5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_ProspectAccept" name="Accept named role capability"><bpmn:incoming>P4</bpmn:incoming><bpmn:outgoing>P6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_ProspectDecline" name="Decline named role capability"><bpmn:incoming>P5</bpmn:incoming><bpmn:outgoing>P7</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ProspectMerge"><bpmn:incoming>P6</bpmn:incoming><bpmn:incoming>P7</bpmn:incoming><bpmn:outgoing>P8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ProspectResponse" name="Response sent for this role"><bpmn:incoming>P8</bpmn:incoming><bpmn:messageEventDefinition messageRef="Message_ProspectResponse" /></bpmn:endEvent>
    <bpmn:sequenceFlow id="P1" sourceRef="Start_Self" targetRef="Task_PrepareSelf" /><bpmn:sequenceFlow id="P2" sourceRef="Task_PrepareSelf" targetRef="End_SelfRequest" />
    <bpmn:sequenceFlow id="P3" sourceRef="Start_ProspectOffer" targetRef="Gateway_ProspectDecision" /><bpmn:sequenceFlow id="P4" name="Accept" sourceRef="Gateway_ProspectDecision" targetRef="Task_ProspectAccept" /><bpmn:sequenceFlow id="P5" name="Decline" sourceRef="Gateway_ProspectDecision" targetRef="Task_ProspectDecline" /><bpmn:sequenceFlow id="P6" sourceRef="Task_ProspectAccept" targetRef="Gateway_ProspectMerge" /><bpmn:sequenceFlow id="P7" sourceRef="Task_ProspectDecline" targetRef="Gateway_ProspectMerge" /><bpmn:sequenceFlow id="P8" sourceRef="Gateway_ProspectMerge" targetRef="End_ProspectResponse" />
  </bpmn:process>

  <bpmn:process id="Process_Active" isExecutable="false">
    <bpmn:startEvent id="Start_Capability" name="Request more role or credential capability"><bpmn:outgoing>A1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_NameCapability" name="Name requested role capability and evidence"><bpmn:incoming>A1</bpmn:incoming><bpmn:outgoing>A2</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_CapabilityRequest" name="Capability request sent"><bpmn:incoming>A2</bpmn:incoming><bpmn:messageEventDefinition messageRef="Message_CapabilityRequest" /></bpmn:endEvent>
    <bpmn:startEvent id="Start_Renounce" name="Unilaterally renounce held role"><bpmn:outgoing>A3</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_NameRenunciation" name="Name held role capability to renounce"><bpmn:incoming>A3</bpmn:incoming><bpmn:outgoing>A4</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Renunciation" name="Named renunciation sent"><bpmn:incoming>A4</bpmn:incoming><bpmn:messageEventDefinition messageRef="Message_Renunciation" /></bpmn:endEvent>
    <bpmn:startEvent id="Start_ActiveOffer" name="Role-specific offer received"><bpmn:outgoing>A5</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_Offer" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_ActiveDecision" name="Accept this role capability?"><bpmn:incoming>A5</bpmn:incoming><bpmn:outgoing>A6</bpmn:outgoing><bpmn:outgoing>A7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_ActiveAccept" name="Accept named role capability"><bpmn:incoming>A6</bpmn:incoming><bpmn:outgoing>A8</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_ActiveDecline" name="Decline named role capability"><bpmn:incoming>A7</bpmn:incoming><bpmn:outgoing>A9</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ActiveMerge"><bpmn:incoming>A8</bpmn:incoming><bpmn:incoming>A9</bpmn:incoming><bpmn:outgoing>A10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ActiveResponse" name="Response sent for this role"><bpmn:incoming>A10</bpmn:incoming><bpmn:messageEventDefinition messageRef="Message_ParticipantResponse" /></bpmn:endEvent>
    <bpmn:sequenceFlow id="A1" sourceRef="Start_Capability" targetRef="Task_NameCapability" /><bpmn:sequenceFlow id="A2" sourceRef="Task_NameCapability" targetRef="End_CapabilityRequest" /><bpmn:sequenceFlow id="A3" sourceRef="Start_Renounce" targetRef="Task_NameRenunciation" /><bpmn:sequenceFlow id="A4" sourceRef="Task_NameRenunciation" targetRef="End_Renunciation" />
    <bpmn:sequenceFlow id="A5" sourceRef="Start_ActiveOffer" targetRef="Gateway_ActiveDecision" /><bpmn:sequenceFlow id="A6" name="Accept" sourceRef="Gateway_ActiveDecision" targetRef="Task_ActiveAccept" /><bpmn:sequenceFlow id="A7" name="Decline" sourceRef="Gateway_ActiveDecision" targetRef="Task_ActiveDecline" /><bpmn:sequenceFlow id="A8" sourceRef="Task_ActiveAccept" targetRef="Gateway_ActiveMerge" /><bpmn:sequenceFlow id="A9" sourceRef="Task_ActiveDecline" targetRef="Gateway_ActiveMerge" /><bpmn:sequenceFlow id="A10" sourceRef="Gateway_ActiveMerge" targetRef="End_ActiveResponse" />
  </bpmn:process>

  <bpmn:process id="Process_Operator" isExecutable="false">
    <bpmn:dataObject id="Data_ActiveGovernance" name="Active Governance Mechanism (version-pinned document from 01B)" /><bpmn:dataObjectReference id="Ref_ActiveGovernance" dataObjectRef="Data_ActiveGovernance" name="Active Governance Mechanism&#10;(version-pinned document from 01B)" />
    <bpmn:dataObject id="Data_AccessRequest" name="Access Request" /><bpmn:dataObjectReference id="Ref_AccessRequest" dataObjectRef="Data_AccessRequest" name="Access Request" />
    <bpmn:dataObject id="Data_GovernedOutcome" name="Governed Outcome" /><bpmn:dataObjectReference id="Ref_GovernedOutcome" dataObjectRef="Data_GovernedOutcome" name="Governed Outcome" />
    <bpmn:dataObject id="Data_Offer" name="Admission or Capability Offer" /><bpmn:dataObjectReference id="Ref_Offer" dataObjectRef="Data_Offer" name="Admission or Capability Offer" />
    <bpmn:dataObject id="Data_Response" name="Participant Response" /><bpmn:dataObjectReference id="Ref_Response" dataObjectRef="Data_Response" name="Participant Response" />
    <bpmn:dataObject id="Data_AccessRecord" name="Participant Access Record" /><bpmn:dataObjectReference id="Ref_AccessRecord" dataObjectRef="Data_AccessRecord" name="Participant Access Record" />
    <bpmn:dataObject id="Data_Bindings" name="Role Capability Bindings" /><bpmn:dataObjectReference id="Ref_Bindings" dataObjectRef="Data_Bindings" name="Role Capability Bindings" />
    <bpmn:dataObject id="Data_Audit" name="Lifecycle Audit Record" /><bpmn:dataObjectReference id="Ref_Audit" dataObjectRef="Data_Audit" name="Lifecycle Audit Record" />
    <bpmn:startEvent id="Start_Admission" name="Sponsored admission request received"><bpmn:outgoing>O1</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_AdmissionRequest" /></bpmn:startEvent>
    <bpmn:startEvent id="Start_SelfRequest" name="Self-request received"><bpmn:outgoing>O2</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_SelfRequest" /></bpmn:startEvent>
    <bpmn:startEvent id="Start_CapabilityRequest" name="Additional capability request received"><bpmn:outgoing>O3</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_CapabilityRequest" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_RequestMerge"><bpmn:incoming>O1</bpmn:incoming><bpmn:incoming>O2</bpmn:incoming><bpmn:incoming>O3</bpmn:incoming><bpmn:outgoing>O4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_ValidateRequest" name="Validate request and governed eligibility policy"><bpmn:incoming>O4</bpmn:incoming><bpmn:outgoing>O5</bpmn:outgoing></bpmn:task>
    <bpmn:callActivity id="Call_GovernedAdmission" name="Obtain governed outcome from 01B" calledElement="Process_01B_Governance"><bpmn:incoming>O5</bpmn:incoming><bpmn:outgoing>O6</bpmn:outgoing></bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_AdmissionOutcome" name="Admission or capability approved?"><bpmn:incoming>O6</bpmn:incoming><bpmn:outgoing>O7</bpmn:outgoing><bpmn:outgoing>O8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="Subprocess_PerCapability" name="For each offered role capability"><bpmn:incoming>O7</bpmn:incoming><bpmn:outgoing>O9</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="false" />
      <bpmn:startEvent id="Start_OfferItem"><bpmn:outgoing>S1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Task_IssueOffer" name="Issue role-specific offer"><bpmn:incoming>S1</bpmn:incoming><bpmn:outgoing>S2</bpmn:outgoing></bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_OfferRecipient" name="Prospective or active participant?"><bpmn:incoming>S2</bpmn:incoming><bpmn:outgoing>S2P</bpmn:outgoing><bpmn:outgoing>S2A</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:intermediateThrowEvent id="Throw_OfferProspect" name="Offer sent to prospective participant"><bpmn:incoming>S2P</bpmn:incoming><bpmn:outgoing>S3P</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_Offer" /></bpmn:intermediateThrowEvent>
      <bpmn:intermediateThrowEvent id="Throw_OfferActive" name="Offer sent to active participant"><bpmn:incoming>S2A</bpmn:incoming><bpmn:outgoing>S3A</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_Offer" /></bpmn:intermediateThrowEvent>
      <bpmn:exclusiveGateway id="Gateway_OfferMerge"><bpmn:incoming>S3P</bpmn:incoming><bpmn:incoming>S3A</bpmn:incoming><bpmn:outgoing>S3</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="Catch_Response" name="Accept or decline received"><bpmn:incoming>S3</bpmn:incoming><bpmn:outgoing>S4</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="Gateway_Accepted" name="Accepted before expiry?"><bpmn:incoming>S4</bpmn:incoming><bpmn:outgoing>S5</bpmn:outgoing><bpmn:outgoing>S6</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:task id="Task_RecordBinding" name="Record accepted binding and scoped credentials"><bpmn:incoming>S5</bpmn:incoming><bpmn:outgoing>S7</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="End_BindingRecorded" name="Accepted binding recorded"><bpmn:incoming>S7</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_NoCredential" name="Rejected, expired, or declined: no credential"><bpmn:incoming>S6</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="S1" sourceRef="Start_OfferItem" targetRef="Task_IssueOffer" /><bpmn:sequenceFlow id="S2" sourceRef="Task_IssueOffer" targetRef="Gateway_OfferRecipient" /><bpmn:sequenceFlow id="S2P" name="Prospective" sourceRef="Gateway_OfferRecipient" targetRef="Throw_OfferProspect" /><bpmn:sequenceFlow id="S2A" name="Active" sourceRef="Gateway_OfferRecipient" targetRef="Throw_OfferActive" /><bpmn:sequenceFlow id="S3P" sourceRef="Throw_OfferProspect" targetRef="Gateway_OfferMerge" /><bpmn:sequenceFlow id="S3A" sourceRef="Throw_OfferActive" targetRef="Gateway_OfferMerge" /><bpmn:sequenceFlow id="S3" sourceRef="Gateway_OfferMerge" targetRef="Catch_Response" /><bpmn:sequenceFlow id="S4" sourceRef="Catch_Response" targetRef="Gateway_Accepted" /><bpmn:sequenceFlow id="S5" name="Accepted" sourceRef="Gateway_Accepted" targetRef="Task_RecordBinding" /><bpmn:sequenceFlow id="S6" name="No" sourceRef="Gateway_Accepted" targetRef="End_NoCredential" /><bpmn:sequenceFlow id="S7" sourceRef="Task_RecordBinding" targetRef="End_BindingRecorded" />
    </bpmn:subProcess>
    <bpmn:task id="Task_AuditAdmission" name="Update participant access and lifecycle audit records"><bpmn:incoming>O8</bpmn:incoming><bpmn:incoming>O9</bpmn:incoming><bpmn:outgoing>O10</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_AdmissionHandled" name="Admission or capability case recorded"><bpmn:incoming>O10</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="Start_Revocation" name="Governed revocation request received"><bpmn:outgoing>O11</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_RevocationRequest" /></bpmn:startEvent>
    <bpmn:callActivity id="Call_GovernedRevocation" name="Obtain governed outcome from 01B" calledElement="Process_01B_Governance"><bpmn:incoming>O11</bpmn:incoming><bpmn:outgoing>O12</bpmn:outgoing></bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_RevocationApproved" name="Named removal approved?"><bpmn:incoming>O12</bpmn:incoming><bpmn:outgoing>O13</bpmn:outgoing><bpmn:outgoing>O14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_RemoveGoverned" name="Remove only named access or capabilities in outcome"><bpmn:incoming>O13</bpmn:incoming><bpmn:outgoing>O15</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_RecordRevocation" name="Preserve unrelated capabilities and record audit"><bpmn:incoming>O14</bpmn:incoming><bpmn:incoming>O15</bpmn:incoming><bpmn:outgoing>O16</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Revocation" name="Governed revocation case recorded"><bpmn:incoming>O16</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="Start_Renunciation" name="Named renunciation received"><bpmn:outgoing>O17</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_Renunciation" /></bpmn:startEvent>
    <bpmn:task id="Task_VerifyControl" name="Verify participant control and held named capability"><bpmn:incoming>O17</bpmn:incoming><bpmn:outgoing>O18</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_RemoveRenounced" name="Remove named capability and scoped credentials only"><bpmn:incoming>O18</bpmn:incoming><bpmn:outgoing>O19</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_RecordRenunciation" name="Preserve unrelated capabilities and record audit"><bpmn:incoming>O19</bpmn:incoming><bpmn:outgoing>O20</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_RenunciationHandled" name="Renunciation recorded without governance"><bpmn:incoming>O20</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="O1" sourceRef="Start_Admission" targetRef="Gateway_RequestMerge" /><bpmn:sequenceFlow id="O2" sourceRef="Start_SelfRequest" targetRef="Gateway_RequestMerge" /><bpmn:sequenceFlow id="O3" sourceRef="Start_CapabilityRequest" targetRef="Gateway_RequestMerge" /><bpmn:sequenceFlow id="O4" sourceRef="Gateway_RequestMerge" targetRef="Task_ValidateRequest" /><bpmn:sequenceFlow id="O5" sourceRef="Task_ValidateRequest" targetRef="Call_GovernedAdmission" /><bpmn:sequenceFlow id="O6" sourceRef="Call_GovernedAdmission" targetRef="Gateway_AdmissionOutcome" /><bpmn:sequenceFlow id="O7" name="Approved" sourceRef="Gateway_AdmissionOutcome" targetRef="Subprocess_PerCapability" /><bpmn:sequenceFlow id="O8" name="Rejected or expired" sourceRef="Gateway_AdmissionOutcome" targetRef="Task_AuditAdmission" /><bpmn:sequenceFlow id="O9" sourceRef="Subprocess_PerCapability" targetRef="Task_AuditAdmission" /><bpmn:sequenceFlow id="O10" sourceRef="Task_AuditAdmission" targetRef="End_AdmissionHandled" />
    <bpmn:sequenceFlow id="O11" sourceRef="Start_Revocation" targetRef="Call_GovernedRevocation" /><bpmn:sequenceFlow id="O12" sourceRef="Call_GovernedRevocation" targetRef="Gateway_RevocationApproved" /><bpmn:sequenceFlow id="O13" name="Approved" sourceRef="Gateway_RevocationApproved" targetRef="Task_RemoveGoverned" /><bpmn:sequenceFlow id="O14" name="Not approved" sourceRef="Gateway_RevocationApproved" targetRef="Task_RecordRevocation" /><bpmn:sequenceFlow id="O15" sourceRef="Task_RemoveGoverned" targetRef="Task_RecordRevocation" /><bpmn:sequenceFlow id="O16" sourceRef="Task_RecordRevocation" targetRef="End_Revocation" />
    <bpmn:sequenceFlow id="O17" sourceRef="Start_Renunciation" targetRef="Task_VerifyControl" /><bpmn:sequenceFlow id="O18" sourceRef="Task_VerifyControl" targetRef="Task_RemoveRenounced" /><bpmn:sequenceFlow id="O19" sourceRef="Task_RemoveRenounced" targetRef="Task_RecordRenunciation" /><bpmn:sequenceFlow id="O20" sourceRef="Task_RecordRenunciation" targetRef="End_RenunciationHandled" />
    <bpmn:association id="Assoc_GovernanceAdmission" sourceRef="Ref_ActiveGovernance" targetRef="Call_GovernedAdmission" associationDirection="One" /><bpmn:association id="Assoc_GovernanceRevocation" sourceRef="Ref_ActiveGovernance" targetRef="Call_GovernedRevocation" associationDirection="One" /><bpmn:association id="Assoc_Request" sourceRef="Ref_AccessRequest" targetRef="Task_ValidateRequest" associationDirection="One" /><bpmn:association id="Assoc_Outcome" sourceRef="Call_GovernedAdmission" targetRef="Ref_GovernedOutcome" associationDirection="One" /><bpmn:association id="Assoc_Offer" sourceRef="Task_IssueOffer" targetRef="Ref_Offer" associationDirection="One" /><bpmn:association id="Assoc_Response" sourceRef="Ref_Response" targetRef="Catch_Response" associationDirection="One" /><bpmn:association id="Assoc_AccessRecord" sourceRef="Task_AuditAdmission" targetRef="Ref_AccessRecord" associationDirection="One" /><bpmn:association id="Assoc_Bindings" sourceRef="Task_RecordBinding" targetRef="Ref_Bindings" associationDirection="One" /><bpmn:association id="Assoc_Audit" sourceRef="Task_RecordRenunciation" targetRef="Ref_Audit" associationDirection="One" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_02_Access"><bpmndi:BPMNPlane id="Plane_02_Access" bpmnElement="Collaboration_02_Access">
    <bpmndi:BPMNShape id="DI_Pool_Governor" bpmnElement="Participant_Governor" isHorizontal="true"><dc:Bounds x="20" y="20" width="2360" height="250" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="DI_Pool_Prospective" bpmnElement="Participant_Prospective" isHorizontal="true"><dc:Bounds x="20" y="290" width="2360" height="300" /></bpmndi:BPMNShape>
