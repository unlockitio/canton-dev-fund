      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VP_End" bpmnElement="VP_End">
        <dc:Bounds x="480" y="300" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="440" y="336" width="116" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_VP1" bpmnElement="VP1">
