<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_veridica_verifier_actions" targetNamespace="https://unlockit.io/veridica/bpmn" exporter="Veridica deterministic renderer" exporterVersion="4.0">
  <bpmn:message id="Message_VerifierAuthorized" name="Verifier_Authorized" />
  <bpmn:message id="Message_VerificationRequest_02c" name="Verification_Request" />
  <bpmn:message id="Message_EvidenceResubmitted" name="Evidence_Resubmitted" />
  <bpmn:message id="Message_VerifierAttestation" name="Verifier_Attestation" />
  <bpmn:message id="Message_VerifierChallenge" name="Verifier_Challenge" />
  <bpmn:message id="Message_GovernanceInterruption_02c" name="Governance suspension mid-verification" />
  <bpmn:collaboration id="Collaboration_02c">
    <bpmn:participant id="Participant_VeridicaPlatform_02c" name="Veridica Platform" processRef="Process_VeridicaPlatform_02c" />
    <bpmn:participant id="Participant_Process_VerifierParty" name="Verifier Party (multiplicity 1..999, mutually exclusive with 02b aggregator)" processRef="Process_VerifierParty">
      <bpmn:participantMultiplicity minimum="1" maximum="999" />
    </bpmn:participant>
    <bpmn:participant id="Participant_Chassis_External_02c" name="Participant lifecycle chassis (02, external source of Verifier_Authorized)">
      <bpmn:participantMultiplicity minimum="1" maximum="999" />
    </bpmn:participant>
    <bpmn:participant id="Participant_Aggregator_External" name="Aggregator Party (02b, external, mutually exclusive with 02c verifier)">
      <bpmn:participantMultiplicity minimum="1" maximum="999" />
    </bpmn:participant>
    <bpmn:participant id="Participant_Contributor_External" name="Contributor Party (02a, external source of Evidence_Resubmitted)">
      <bpmn:participantMultiplicity minimum="1" maximum="999" />
    </bpmn:participant>
    <bpmn:messageFlow id="MF_VerifierAuthorized" name="Verifier_Authorized" sourceRef="Participant_Chassis_External_02c" targetRef="VR_Authorized" />
    <bpmn:messageFlow id="MF_VerificationRequest_02c" name="Verification_Request" sourceRef="Participant_Aggregator_External" targetRef="VR_VerificationRequestReceived" />
    <bpmn:messageFlow id="MF_EvidenceResubmitted" name="Evidence_Resubmitted" sourceRef="Participant_Contributor_External" targetRef="VR_EvidenceResubmittedReceived" />
    <bpmn:messageFlow id="MF_VerifierAttestation" name="Verifier_Attestation" sourceRef="VR_AttestationSent" targetRef="VP_AttestationReceived" />
    <bpmn:messageFlow id="MF_VerifierChallenge" name="Verifier_Challenge" sourceRef="VR_ChallengeSent" targetRef="VP_ChallengeReceived" />
    <bpmn:messageFlow id="MF_GovernanceInterruption_02c" name="Governance suspension mid-verification" sourceRef="Participant_Chassis_External_02c" targetRef="VR_GovernanceInterruption" />
  </bpmn:collaboration>
  <bpmn:process id="Process_VeridicaPlatform_02c" isExecutable="false">
    <bpmn:laneSet id="Lanes_VeridicaPlatform_02c">
      <bpmn:lane id="Lane_VeridicaPlatform_02c" name="Veridica Platform">
        <bpmn:flowNodeRef>VP_AttestationReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_ChallengeReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_RecordOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="VP_AttestationReceived" name="Verifier_Attestation received">
      <bpmn:incoming>VP1</bpmn:incoming>
      <bpmn:outgoing>VP2</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_VerifierAttestation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="VP_ChallengeReceived" name="Verifier_Challenge received">
      <bpmn:incoming>VP1b</bpmn:incoming>
      <bpmn:outgoing>VP2</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_VerifierChallenge" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="VP_RecordOutcome" name="Record verifier attestation or challenge">
      <bpmn:incoming>VP2</bpmn:incoming>
      <bpmn:outgoing>VP3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="VP_End" name="Outcome recorded">
      <bpmn:incoming>VP3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="VP1" sourceRef="VP_AttestationReceived" targetRef="VP_RecordOutcome" />
    <bpmn:sequenceFlow id="VP1b" sourceRef="VP_ChallengeReceived" targetRef="VP_RecordOutcome" />
    <bpmn:sequenceFlow id="VP2" sourceRef="VP_AttestationReceived" targetRef="VP_RecordOutcome" />
    <bpmn:sequenceFlow id="VP3" sourceRef="VP_RecordOutcome" targetRef="VP_End" />
  </bpmn:process>
  <bpmn:process id="Process_VerifierParty" isExecutable="false">
    <bpmn:laneSet id="Lanes_VerifierParty">
      <bpmn:lane id="Lane_VerifierParty" name="Verifier Party">
        <bpmn:flowNodeRef>VR_Authorized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_WaitForInput</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_EvidenceResubmittedReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_CheckEvidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_AttestIndividual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_ChallengeIndividual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_AttestationSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_ChallengeSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_VerificationRequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_ValidateMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_AttestAggregate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_ChallengeAggregate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_GovernanceInterruption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_ApplyInterruption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_Suspended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VR_LoopBack</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="VR_Authorized" name="Verifier_Authorized received">
      <bpmn:outgoing>VR1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_VerifierAuthorized" />
    </bpmn:startEvent>
    <bpmn:eventBasedGateway id="VR_WaitForInput" name="Wait for Evidence_Resubmitted (02a) or Verification_Request (02b)">
      <bpmn:incoming>VR1</bpmn:incoming>
      <bpmn:outgoing>VR2</bpmn:outgoing>
      <bpmn:outgoing>VR3</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="VR_EvidenceResubmittedReceived" name="Evidence_Resubmitted received from 02a contributor">
      <bpmn:incoming>VR2</bpmn:incoming>
      <bpmn:outgoing>VR4</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_EvidenceResubmitted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="VR_VerificationRequestReceived" name="Verification_Request received from 02b aggregator">
      <bpmn:incoming>VR3</bpmn:incoming>
      <bpmn:outgoing>VR7</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_VerificationRequest_02c" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="VR_CheckEvidence" name="Check evidence: validation rules, independence, and conflicts">
      <bpmn:incoming>VR4</bpmn:incoming>
      <bpmn:outgoing>VR5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="VR_IndividualDecision" name="Individual verification outcome" gatewayDirection="Diverging">
      <bpmn:incoming>VR5</bpmn:incoming>
      <bpmn:outgoing>VR6a</bpmn:outgoing>
      <bpmn:outgoing>VR6b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="VR_AttestIndividual" name="Attest with limitations">
      <bpmn:incoming>VR6a</bpmn:incoming>
      <bpmn:outgoing>VR6c</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="VR_AttestationSent" name="Verifier_Attestation sent">
      <bpmn:incoming>VR6c</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_VerifierAttestation" />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="VR_ChallengeIndividual" name="Challenge or request evidence">
      <bpmn:incoming>VR6b</bpmn:incoming>
      <bpmn:outgoing>VR6d</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="VR_ChallengeSent" name="Verifier_Challenge sent">
      <bpmn:incoming>VR6d</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_VerifierChallenge" />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="VR_ValidateMethod" name="Validate method: inputs, independence, evidence, and confidence">
      <bpmn:incoming>VR7</bpmn:incoming>
      <bpmn:outgoing>VR8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="VR_AggregateDecision" name="Aggregate-attestation outcome" gatewayDirection="Diverging">
      <bpmn:incoming>VR8</bpmn:incoming>
      <bpmn:outgoing>VR9a</bpmn:outgoing>
      <bpmn:outgoing>VR9b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="VR_AttestAggregate" name="Aggregate-attestation: Attest with limitations">
      <bpmn:incoming>VR9a</bpmn:incoming>
      <bpmn:outgoing>VR9c</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="VR_AttestationSent2" name="Verifier_Attestation sent (aggregate)">
      <bpmn:incoming>VR9c</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_VerifierAttestation" />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="VR_ChallengeAggregate" name="Aggregate-attestation: Challenge method or input">
      <bpmn:incoming>VR9b</bpmn:incoming>
      <bpmn:outgoing>VR9d</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="VR_ChallengeSent2" name="Verifier_Challenge sent (aggregate)">
      <bpmn:incoming>VR9d</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_VerifierChallenge" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="VR_LoopBack" name="Loop back to wait?" gatewayDirection="Converging">
      <bpmn:incoming>VR10a</bpmn:incoming>
      <bpmn:incoming>VR10b</bpmn:incoming>
      <bpmn:incoming>VR10c</bpmn:incoming>
      <bpmn:incoming>VR10d</bpmn:incoming>
      <bpmn:outgoing>VR11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="VR_GovernanceInterruption" name="Governance suspension mid-verification" attachedToRef="VR_ValidateMethod">
      <bpmn:outgoing>VR_BI1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_GovernanceInterruption_02c" />
    </bpmn:boundaryEvent>
    <bpmn:task id="VR_ApplyInterruption" name="Apply governance suspension">
      <bpmn:incoming>VR_BI1</bpmn:incoming>
      <bpmn:outgoing>VR_BI2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="VR_Suspended" name="Verifier suspended by governance">
      <bpmn:incoming>VR_BI2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="VR1" sourceRef="VR_Authorized" targetRef="VR_WaitForInput" />
    <bpmn:sequenceFlow id="VR2" sourceRef="VR_WaitForInput" targetRef="VR_EvidenceResubmittedReceived" />
    <bpmn:sequenceFlow id="VR3" sourceRef="VR_WaitForInput" targetRef="VR_VerificationRequestReceived" />
    <bpmn:sequenceFlow id="VR4" sourceRef="VR_EvidenceResubmittedReceived" targetRef="VR_CheckEvidence" />
    <bpmn:sequenceFlow id="VR5" sourceRef="VR_CheckEvidence" targetRef="VR_IndividualDecision" />
    <bpmn:sequenceFlow id="VR6a" name="Attest" sourceRef="VR_IndividualDecision" targetRef="VR_AttestIndividual" />
    <bpmn:sequenceFlow id="VR6b" name="Challenge" sourceRef="VR_IndividualDecision" targetRef="VR_ChallengeIndividual" />
    <bpmn:sequenceFlow id="VR6c" sourceRef="VR_AttestIndividual" targetRef="VR_AttestationSent" />
    <bpmn:sequenceFlow id="VR6d" sourceRef="VR_ChallengeIndividual" targetRef="VR_ChallengeSent" />
    <bpmn:sequenceFlow id="VR7" sourceRef="VR_VerificationRequestReceived" targetRef="VR_ValidateMethod" />
    <bpmn:sequenceFlow id="VR8" sourceRef="VR_ValidateMethod" targetRef="VR_AggregateDecision" />
    <bpmn:sequenceFlow id="VR9a" name="Attest" sourceRef="VR_AggregateDecision" targetRef="VR_AttestAggregate" />
    <bpmn:sequenceFlow id="VR9b" name="Challenge" sourceRef="VR_AggregateDecision" targetRef="VR_ChallengeAggregate" />
    <bpmn:sequenceFlow id="VR9c" sourceRef="VR_AttestAggregate" targetRef="VR_AttestationSent2" />
    <bpmn:sequenceFlow id="VR9d" sourceRef="VR_ChallengeAggregate" targetRef="VR_ChallengeSent2" />
    <bpmn:sequenceFlow id="VR10a" sourceRef="VR_AttestationSent" targetRef="VR_LoopBack" />
    <bpmn:sequenceFlow id="VR10b" sourceRef="VR_ChallengeSent" targetRef="VR_LoopBack" />
    <bpmn:sequenceFlow id="VR10c" sourceRef="VR_AttestationSent2" targetRef="VR_LoopBack" />
    <bpmn:sequenceFlow id="VR10d" sourceRef="VR_ChallengeSent2" targetRef="VR_LoopBack" />
    <bpmn:sequenceFlow id="VR11" sourceRef="VR_LoopBack" targetRef="VR_WaitForInput" />
    <bpmn:sequenceFlow id="VR_BI1" sourceRef="VR_GovernanceInterruption" targetRef="VR_ApplyInterruption" />
    <bpmn:sequenceFlow id="VR_BI2" sourceRef="VR_ApplyInterruption" targetRef="VR_Suspended" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_02c">
    <bpmndi:BPMNPlane id="Plane_02c" bpmnElement="Collaboration_02c">
      <bpmndi:BPMNShape id="DI_Chassis_External_02c" bpmnElement="Participant_Chassis_External_02c" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1540" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Aggregator_External" bpmnElement="Participant_Aggregator_External" isHorizontal="true">
