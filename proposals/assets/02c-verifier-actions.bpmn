      <bpmndi:BPMNShape id="DI_Participant_Process_VerifierParty" bpmnElement="Participant_Process_VerifierParty" isHorizontal="true">
        <dc:Bounds x="20" y="390" width="1540" height="540" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_Authorized" bpmnElement="VR_Authorized">
