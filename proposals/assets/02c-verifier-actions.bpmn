          <dc:Bounds x="620" y="446" width="156" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_AttestAggregate" bpmnElement="VR_AttestAggregate">
        <dc:Bounds x="760" y="540" width="180" height="46" rx="8" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_AttestationSent2" bpmnElement="VR_AttestationSent2">
        <dc:Bounds x="980" y="545" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="940" y="581" width="156" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_ChallengeAggregate" bpmnElement="VR_ChallengeAggregate">
        <dc:Bounds x="760" y="620" width="180" height="46" rx="8" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_ChallengeSent2" bpmnElement="VR_ChallengeSent2">
        <dc:Bounds x="980" y="625" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="940" y="661" width="156" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
