        <dc:Bounds x="1140" y="500" width="56" height="56" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1100" y="456" width="156" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_GovernanceInterruption" bpmnElement="VR_GovernanceInterruption">
        <dc:Bounds x="492" y="550" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="448" y="586" width="156" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_ApplyInterruption" bpmnElement="VR_ApplyInterruption">
        <dc:Bounds x="420" y="700" width="200" height="46" rx="8" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_VR_Suspended" bpmnElement="VR_Suspended">
        <dc:Bounds x="660" y="705" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="620" y="741" width="156" height="27" />
