        <dc:Bounds x="980" y="375" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="940" y="411" width="156" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
